    private static boolean mpBraceOwner(IsoPlayer player,int cartId) {
        var item=player==null?null:player.getPrimaryHandItem();
        // Native menu Host can report isFullyConnected=false after authoritative fixture arming.
        // This read-only sample belongs to the exact live local owner and server-issued held cart.
        return zombie.network.GameClient.client && !zombie.network.GameServer.server
            && zombie.network.GameClient.connection!=null && zombie.network.GameClient.instance.connected && player!=null
            && player==IsoPlayer.getInstance() && player.isLocalPlayer() && !player.isDead()
            && "client1".equals(player.getUsername()) && player.getOnlineID()>=0 && player.getCurrentSquare()!=null
            && item!=null && item.getID()==cartId && item==player.getSecondaryHandItem()
            && "SaucedWheelbarrow.WheelbarrowWood".equals(item.getFullType())
            && player.getInventory()!=null && item.getContainer()==player.getInventory();
    }

    @LuaMethod(name="cartMPBrace", global=true)
    public static String mpBrace(IsoPlayer player,int cartId,double wallX,double y) throws Exception {
        if(!mpBraceOwner(player,cartId))
            throw new IllegalStateException("Live native MP fixture owner and exact held cart required");
        int z=(int)Math.floor(player.getZ());
        float x=(float)wallX,fy=(float)y;
        if(!Float.isFinite(x+fy) || z<=0 || Math.abs(x-player.getX())>16 || Math.abs(fy-player.getY())>16)
            throw new IllegalArgumentException("Loaded local upper-pad wall query required");
        var cell=player.getCell();
        if(cell.getGridSquare((int)Math.floor(x-.5),(int)Math.floor(fy),z)==null
            || cell.getGridSquare((int)Math.floor(x+.5),(int)Math.floor(fy),z)==null)
            throw new IllegalStateException("Wall query squares must remain loaded");
        var hooks=Class.forName("net.alexredby.pztoolkitjavapatches.CartSteeringHooks");
        var states=hooks.getDeclaredField("states");states.setAccessible(true);
        Object state=((java.util.Map<?,?>)states.get(null)).get(player);
        if(state==null) throw new IllegalStateException("Cart state required");
        var amount=state.getClass().getDeclaredField("brace");amount.setAccessible(true);
        var intent=state.getClass().getDeclaredField("wantsMove");intent.setAccessible(true);
        double value=amount.getDouble(state);
        if(!Double.isFinite(value) || value<0 || value>1) throw new IllegalStateException("Invalid brace amount");
        boolean blocked=zombie.pathfind.PolygonalMap2.instance.lineClearCollide(x+.5f,fy,x-.5f,fy,z,null,zombie.pathfind.PolygonalMap2.LCC_ZERO);
        return "brace="+value+" nativeBlocked="+blocked+" wantsMove="+intent.getBoolean(state);
    }

    private static String mpJsonString(String value) {
        if(value==null)return "null";
        var out=new StringBuilder("\"");
        for(char c:value.toCharArray()) {
            if(c=='\\' || c=='\"')out.append('\\').append(c);
            else if(c<32)out.append(String.format("\\u%04x",(int)c));
            else out.append(c);
        }
        return out.append('"').toString();
    }

    @LuaMethod(name="cartMPSeedSprinting", global=true)
    public static int seedSprinting(IsoPlayer p) {
        if(!zombie.network.GameServer.server || zombie.network.GameClient.client || p==null
            || !"client1".equals(p.getUsername()) || p.isDead() || !p.isExistInTheWorld()
            || zombie.network.GameServer.getConnectionFromPlayer(p)==null)
            throw new IllegalStateException("Connected fixture owner on the native server required");
        var perk=zombie.characters.skills.PerkFactory.Perks.Sprinting;
        p.setPerkLevelDebug(perk,10);p.getXp().setXPToLevel(perk,10);
        p.getNetworkCharacterAI().updateXpChecker();
        zombie.network.packets.INetworkPacket.send(p,zombie.network.PacketTypes.PacketType.PlayerXp,p);
        return p.getPerkLevel(perk);
    }

    @LuaMethod(name="cartMPPadHost", global=true)
    public static boolean padHost() {
        if(!zombie.network.GameServer.server || zombie.network.GameClient.client
            || zombie.network.CoopSlave.instance==null || !"queue-smoke".equals(zombie.network.GameServer.serverName)) return false;
        try {
            var field=zombie.network.GameServer.class.getDeclaredField("worldExistedAtStartup");
            field.setAccessible(true);
            return !field.getBoolean(null);
        } catch(ReflectiveOperationException unavailable) {return false;}
    }

    @LuaMethod(name="cartMPState", global=true)
    public static String mpState(IsoPlayer p) {
        timelineStats(p);
        var a=p.getPrimaryHandItem(); var b=p.getSecondaryHandItem();
        var network=p.getNetworkCharacterAI();
        var cargo=a instanceof zombie.inventory.types.InventoryContainer cart?cart.getInventory():null;
        int cargoCount=cargo==null?0:cargo.getItems().size();
        int inventoryCount=0;
        if(a!=null)for(var item:p.getInventory().getItems())if(item.getID()==a.getID())inventoryCount++;
        var world=a==null?null:a.getWorldItem();
        var out=new StringBuilder("{\"wall\":").append(System.currentTimeMillis())
            .append(",\"id\":").append(p.getOnlineID()).append(",\"user\":\"").append(p.getUsername())
            .append("\",\"local\":").append(p.isLocalPlayer()).append(",\"enabled\":")
            .append(net.alexredby.pztoolkitjavapatches.CartSteeringHooks.enabled(p))
            .append(",\"x\":").append(p.getX()).append(",\"y\":").append(p.getY()).append(",\"z\":").append(p.getZ())
            .append(",\"realX\":").append(p.realx).append(",\"realY\":").append(p.realy)
            .append(",\"targetX\":").append(network==null?0:network.targetX)
            .append(",\"targetY\":").append(network==null?0:network.targetY)
            .append(",\"predictionType\":").append(network==null?-1:network.predictionType)
            .append(",\"female\":").append(p.isFemale())
            .append(",\"hasPath\":").append(p.hasPath())
            .append(",\"nativeMoving\":").append(p.isPlayerMoving())
            .append(",\"deferredLength\":").append(p.getDeferredMovement(new zombie.iso.Vector2()).getLength())
            .append(",\"heading\":").append(p.getDirectionAngleRadians()).append(",\"run\":").append(p.isRunning())
            .append(",\"sprint\":").append(p.isSprinting())
            .append(",\"canSprint\":").append(p.canSprint())
            .append(",\"sprintLevel\":").append(p.getPerkLevel(zombie.characters.skills.PerkFactory.Perks.Sprinting))
            .append(",\"sprintButtonDown\":").append(p.getCharacterInputComponent().isSprintButtonDown())
            .append(",\"justMoved\":").append(p.isJustMoved())
            .append(",\"inTrees\":").append(p.isInTrees())
            .append(",\"inTreesNoBush\":").append(p.isInTreesNoBush())
            .append(",\"collapsedFence\":").append(p.getCurrentSquare()!=null && zombie.iso.BentFences.getInstance().getCollapsedFence(p.getCurrentSquare())!=null)
            .append(",\"walkSpeed\":").append(p.getVariableFloat("WalkSpeed",-1))
            .append(",\"walkInjury\":").append(p.getVariableFloat("WalkInjury",-1))
            .append(",\"endurance\":").append(p.getStats().get(zombie.characters.CharacterStat.ENDURANCE))
            .append(",\"enduranceMoodle\":").append(p.getMoodles().getMoodleLevel(zombie.scripting.objects.MoodleType.ENDURANCE))
            .append(",\"primary\":").append(a==null?-1:a.getID())
            .append(",\"secondary\":").append(b==null?-1:b.getID()).append(",\"item\":\"").append(a==null?"none":a.getFullType()).append('"')
            .append(",\"modelProbeVersion\":1,\"heldModel\":").append(mpJsonString(a==null?null:a.getStaticModel()))
            .append(",\"overridePrimary\":").append(mpJsonString(p.overridePrimaryHandModel))
            .append(",\"overrideSecondary\":").append(mpJsonString(p.overrideSecondaryHandModel))
            .append(",\"performing\":").append(p.getVariableBoolean("IsPerformingAnAction"))
            .append(",\"action\":").append(mpJsonString(p.getVariableString("PerformingAction")))
            .append(",\"inventoryCount\":").append(inventoryCount)
            .append(",\"inventoryScope\":").append(mpJsonString(p.isLocalPlayer() || zombie.network.GameServer.server
                ?"owner-inventory":"remote-hand-snapshot"))
            .append(",\"worldID\":").append(world==null || world.getItem()==null?-1:world.getItem().getID())
            .append(",\"primaryInInventory\":").append(a!=null && a.getContainer()==p.getInventory())
            .append(",\"characterActions\":").append(p.getCharacterActions().size())
            .append(",\"cargoCount\":").append(cargoCount)
            .append(",\"cargoID\":").append(cargoCount==1?cargo.getItems().get(0).getID():-1)
            .append(",\"cargoWeight\":").append(cargo==null?0:cargo.getCapacityWeight())
            .append(",\"brace\":").append(p.getVariableBoolean("ToolkitCartBrace"))
            .append(",\"motion\":").append(p.getVariableBoolean("ToolkitCartMotion"))
            .append(",\"visualEnabled\":").append(net.alexredby.pztoolkitjavapatches.CartMotionSync.visualEnabled(p))
            .append(",\"poseRegistered\":").append(zombie.network.packets.VariableSyncPacket.syncedVariables.contains("ToolkitCartPose"))
            .append(",\"actionPoseRegistered\":").append(zombie.network.packets.VariableSyncPacket.syncedVariables.contains("ToolkitCartActionPose"))
            .append(",\"fullyConnected\":").append(zombie.network.GameClient.connection!=null && zombie.network.GameClient.connection.isFullyConnected())
            .append(",\"pose\":\"").append(p.getVariableString("ToolkitCartPose")).append('"')
            .append(",\"actionPose\":\"").append(p.getVariableString("ToolkitCartActionPose")).append('"')
            .append(",\"pivot\":").append(p.getVariableBoolean("ToolkitCartPivot"))
            .append(",\"stepX\":").append(p.getVariableFloat("ToolkitCartStepX",0))
            .append(",\"stepY\":").append(p.getVariableFloat("ToolkitCartStepY",0))
            .append(",\"pace\":").append(p.getVariableFloat("ToolkitCartLegPace",0))
            .append(",\"bank\":").append(net.alexredby.pztoolkitjavapatches.CartSteeringHooks.lean(p))
            .append(",\"tracks\":\"");
        if(p.getAnimationPlayer()!=null && p.getAnimationPlayer().getMultiTrack()!=null)
            for(var t:p.getAnimationPlayer().getMultiTrack().getTracks())out.append(t.getName()).append('=').append(t.getSpeedDelta()).append('@').append(t.getBlendWeight()).append(';');
        out.append("\",\"trackProgress\":[");
        boolean comma=false;
        if(p.getAnimationPlayer()!=null && p.getAnimationPlayer().getMultiTrack()!=null)
            for(var t:p.getAnimationPlayer().getMultiTrack().getTracks()) {
                if(comma)out.append(',');comma=true;
                out.append("{\"name\":").append(mpJsonString(t.getName()))
                    .append(",\"time\":").append(t.getCurrentTrackTime())
                    .append(",\"duration\":").append(t.getDuration())
                    .append(",\"weight\":").append(t.getBlendWeight()).append('}');
            }
        return out.append("]}").toString();
    }

    @LuaMethod(name="cartMPCamera", global=true)
    public static void camera(IsoPlayer p) {
        var self=IsoPlayer.getInstance();
        if(TIMELINE && "true".equals(System.getenv("PZ_CART_INVENTORY_EQUIP"))
            && self!=null && self.isLocalPlayer() && "client2".equals(self.getUsername())
            && p!=null && p!=self && "client1".equals(p.getUsername())) {
            if(timelineCameraOwner==null || timelineCameraOwner.get()!=p)timelineCameraOwner=new java.lang.ref.WeakReference<>(p);
            timelinePan(zombie.iso.IsoCamera.cameras[0]);
            zoom(false);
        }
        float x=p.getX()-self.getX(),y=p.getY()-self.getY();
        float length=(float)Math.hypot(x,y);
        if(length>1e-5f){self.setTargetAndCurrentDirection(x/length,y/length);self.getAnimationPlayer().setTargetAndCurrentDirection(x/length,y/length);}
    }

    @LuaMethod(name="cartMPZoom", global=true)
    public static float zoom(boolean observer) {
        var core=zombie.core.Core.getInstance();
        core.setAutoZoom(0,false);
        core.offscreenBuffer.setZoomAndTargetZoom(0,observer?1f:.25f);
        return core.getZoom(0);
    }

    @LuaMethod(name="cartMPHideUI", global=true)
    public static void hideUI() {
        zombie.ui.UIManager.setVisibleAllUI(false);
        for(var ui:zombie.ui.UIManager.getUI()) if(ui instanceof zombie.ui.UIElement element) element.setVisible(false);
    }

    private static final java.util.concurrent.atomic.LongAdder posePackets=new java.util.concurrent.atomic.LongAdder();
    private static final java.util.concurrent.atomic.LongAdder poseBytes=new java.util.concurrent.atomic.LongAdder();

    @Patch(className="zombie.network.packets.VariableSyncPacket", methodName="write", warmUp=true)
    public static class PoseTraffic {
        @Patch.OnEnter
        public static void enter(@Patch.Argument(0) zombie.core.network.ByteBufferWriter writer,
                @Patch.Local("position") int position) {
            position=writer.bb.position();
        }
        @Patch.OnExit
        public static void exit(@Patch.This zombie.network.packets.VariableSyncPacket packet,
                @Patch.Argument(0) zombie.core.network.ByteBufferWriter writer,
                @Patch.Local("position") int position) {
            Main.recordPoseTraffic(packet.key,writer.bb.position()-position);
            Main.timelinePacket(packet,"variable-write",writer.bb.position()-position);
        }
    }

    public static void recordPoseTraffic(String key,int bytes) {
        if("ToolkitCartPose".equals(key) || "ToolkitCartActionPose".equals(key)) {
            posePackets.increment();poseBytes.add(bytes);
        }
    }

    @LuaMethod(name="cartMPTraffic", global=true)
    public static String traffic() {
        return "{\"wall\":"+System.currentTimeMillis()+",\"packets\":"+posePackets.sum()+",\"serializedBytes\":"+poseBytes.sum()+"}";
    }


    // Test-only observations. No packet, game variable or connection settings are changed.
    private static final boolean TIMELINE="true".equals(System.getenv("PZ_CART_TIMELINE"));
    private static final java.util.concurrent.ArrayBlockingQueue<String> timelineRows=new java.util.concurrent.ArrayBlockingQueue<>(8192);
    private static java.io.BufferedWriter timelineOutput;
    private static Thread timelineThread;
    private static long timelineSequence,timelineBytes,nextTimelineStats;
    private static volatile boolean timelineFailed,timelineClosing;
    private static int timelineLastOwnerID;
    private static String timelineActor;
    private static java.lang.ref.WeakReference<IsoPlayer> timelineBoundOwner;
    private static int timelineBoundConnectionToken;
    private static final long TIMELINE_MAX_BYTES=64L*1024*1024;
    private static String timelineRole() {
        if(zombie.network.GameServer.server)return "server";
        var p=IsoPlayer.getInstance();return p==null?"unbound":p.getUsername();
    }
    private static boolean timelineOwner(IsoPlayer p) {
        return TIMELINE && p!=null && p.getOnlineID()>=0 && "client1".equals(p.getUsername())
            && (zombie.network.GameServer.server || zombie.network.GameClient.client);
    }
    public static void timelineError(Throwable error) {
        if(!timelineFailed)System.err.println("[CART_TIMELINE] ERROR "+error);
        timelineFailed=true;
    }
    private static void timelineStart() throws Exception {
        if(timelineThread!=null)return;
        Path configured=runtime.getParent().getParent().toAbsolutePath().normalize();
        Path cache=Path.of(zombie.ZomboidFileSystem.instance.getCacheDir()).toAbsolutePath().normalize();
        if(!cache.equals(configured))throw new IllegalStateException("Timeline cache does not match the owned fixture root");
        // Native menu Host intentionally shares the owner's cache/environment.
        // Give the child its own file rather than overwriting the owner's trace.
        Path path=cache.resolve(zombie.network.GameServer.server?"cart-timeline-server.jsonl":"cart-timeline.jsonl");
        timelineOutput=Files.newBufferedWriter(path,java.nio.file.StandardOpenOption.CREATE_NEW);
        timelineThread=new Thread(()-> {
            try {
                while(!timelineClosing || !timelineRows.isEmpty()) {
                    String row=timelineRows.poll(100,java.util.concurrent.TimeUnit.MILLISECONDS);
                    if(row!=null) {
                        // UTF-8 budget, including the newline; never leave a partial JSON row.
                        long bytes=row.getBytes(java.nio.charset.StandardCharsets.UTF_8).length+1;
                        if(timelineBytes+bytes>TIMELINE_MAX_BYTES)throw new java.io.IOException("64MiB trace limit");
                        timelineOutput.write(row);timelineOutput.newLine();timelineBytes+=bytes;
                    }
                    if(row==null || timelineRows.isEmpty())timelineOutput.flush();
                }
                timelineOutput.close();
            } catch(Throwable error) {timelineError(error);try{timelineOutput.close();}catch(Exception ignored){}}
        },"CartTimelineWriter");
        timelineThread.setDaemon(true);timelineThread.start();
        Runtime.getRuntime().addShutdownHook(new Thread(()-> {
            timelineStop();
            try {timelineThread.join(1500);}catch(InterruptedException e){Thread.currentThread().interrupt();}
            if(timelineThread.isAlive())timelineError(new java.io.IOException("Writer did not drain at shutdown"));
        },"CartTimelineClose"));
    }
    public static synchronized void timelineEvent(String event,IsoPlayer owner,String fields) {
        if(!timelineOwner(owner) || timelineFailed || timelineClosing)return;
        try {
            timelineStart();timelineLastOwnerID=owner.getOnlineID();timelineActor=timelineRole();
            if(timelineBoundOwner==null || timelineBoundOwner.get()!=owner)timelineBoundOwner=new java.lang.ref.WeakReference<>(owner);
            if(!zombie.network.GameServer.server && zombie.network.GameClient.connection!=null)timelineBoundConnectionToken=System.identityHashCode(zombie.network.GameClient.connection);
            timelineFlushClock(owner);
            long mono=System.nanoTime(),server=zombie.GameTime.getServerTime();
            boolean ready=zombie.network.GameServer.server || zombie.GameTime.getServerTimeShiftIsSet();
            String row="{\"schema\":1,\"event\":"+mpJsonString(event)+",\"actor\":"+mpJsonString(timelineActor)
                +",\"seq\":"+(++timelineSequence)+",\"monoNs\":"+mono+",\"serverNs\":"+server+",\"clockReady\":"+ready
                +",\"wallMs\":"+System.currentTimeMillis()+",\"ownerID\":"+owner.getOnlineID()+fields+"}";
            if(!timelineRows.offer(row))throw new java.io.IOException("8192-row trace queue overflow");
        } catch(Throwable error) {timelineError(error);}
    }
    public static synchronized void timelineStop() {
        if(!TIMELINE || timelineClosing)return;
        if(timelineThread!=null && !timelineFailed) {
            long server=zombie.GameTime.getServerTime();
            String end="{\"schema\":1,\"event\":\"trace-end\",\"actor\":"+mpJsonString(timelineActor)
                +",\"seq\":"+(++timelineSequence)+",\"monoNs\":"+System.nanoTime()+",\"serverNs\":"+server
                +",\"clockReady\":"+(server!=0)+",\"wallMs\":"+System.currentTimeMillis()
                +",\"ownerID\":"+timelineLastOwnerID+",\"failed\":false}";
            if(!timelineRows.offer(end))timelineError(new java.io.IOException("Trace end queue overflow"));
        }
        timelineClosing=true;
    }
    public static String timelinePose(String key,String value) {
        if(!"ToolkitCartPose".equals(key) && !"ToolkitCartActionPose".equals(key))return null;
        String identity=",\"key\":"+mpJsonString(key);
        if(value!=null && value.length()>300)return identity+",\"shapeError\":true";
        identity+=",\"raw\":"+mpJsonString(value);
        if(value==null || value.isEmpty())return identity+",\"clear\":true";
        var f=value.split(",",-1);boolean motion="ToolkitCartPose".equals(key);
        try {
            if(f.length!=(motion?13:14) || !"1".equals(f[0]))throw new IllegalArgumentException("pose shape");
            int cart=Integer.parseInt(f[motion?1:2]);long serial=Long.parseLong(f[motion?2:1]);
            if(serial<=0)throw new IllegalArgumentException("pose serial");
            return identity+",\"cartID\":"+cart+",\"serial\":"+serial
                +(motion?"":",\"actionGeneration\":"+Long.parseLong(f[3]));
        } catch(RuntimeException error) {return identity+",\"shapeError\":true";}
    }
    public static void timelineVariable(IsoPlayer player,String event,String key,String value) {
        if(!timelineOwner(player))return;
        String fields=timelinePose(key,value);if(fields!=null)timelineEvent(event,player,fields);
    }
    public static void timelinePacket(zombie.network.packets.VariableSyncPacket packet,String event,int bytes) {
        try {
            if(!TIMELINE || packet==null || packet.player==null)return;
            String fields=timelinePose(packet.key,packet.value);
            if(fields!=null)timelineEvent(event,packet.player.getPlayer(),fields+",\"serializedBytes\":"+bytes);
            if("variable-process-server-exit".equals(event))timelineStats(packet.player.getPlayer());
        } catch(Throwable error) {timelineError(error);}
    }
    public static String timelineNative(zombie.network.fields.character.Prediction prediction) {
        return ",\"predictionType\":"+prediction.type+",\"predictionX\":"+prediction.x+",\"predictionY\":"+prediction.y
            +",\"predictionZ\":"+prediction.z+",\"predictionDirection\":"+prediction.direction
            +",\"predictionMoveDirection\":"+prediction.moveDirection+",\"predictionSpeed\":"+prediction.speed
            +",\"predictionTimeRemaining\":"+prediction.predictionTimeRemaining;
    }
    public static void timelinePlayer(zombie.network.packets.character.PlayerPacket packet,String event,int bytes) {
        try {if(TIMELINE)timelineEvent(event,packet.getPlayer(),timelineNative(packet.prediction)+",\"serializedBytes\":"+bytes);}
        catch(Throwable error){timelineError(error);}
    }
    public static void timelineRemote(IsoPlayer player,String event) {
        try {
            if(!timelineOwner(player) || player.isLocalPlayer())return;
            var ai=player.getNetworkCharacterAI();
            String fields=",\"x\":"+player.getX()+",\"y\":"+player.getY()+",\"heading\":"+player.getDirectionAngleRadians()
                +",\"targetX\":"+ai.targetX+",\"targetY\":"+ai.targetY+timelineNative(ai.prediction);
            for(String key:new String[]{"ToolkitCartPose","ToolkitCartActionPose"})
                timelineEvent(event,player,fields+timelinePose(key,player.getVariableString(key)));
        } catch(Throwable error){timelineError(error);}
    }
    public static void timelineStats(IsoPlayer owner) {
        if(!timelineOwner(owner) || timelineFailed)return;
        long now=System.nanoTime();if(now<nextTimelineStats)return;nextTimelineStats=now+1_000_000_000L;
        try {
            if(zombie.network.GameServer.server) {
                for(var connection:zombie.network.GameServer.udpEngine.connections)
                    if(connection.hasPlayer("client1") || connection.hasPlayer("client2"))timelineConnection(owner,connection);
            } else if(zombie.network.GameClient.connection!=null)timelineConnection(owner,zombie.network.GameClient.connection);
        } catch(Throwable error){timelineError(error);}
    }
    private static void timelineConnection(IsoPlayer owner,zombie.core.raknet.UdpConnection connection) {
        var stats=connection.getStatistics();
        String fields=",\"connectionGUID\":"+mpJsonString(Long.toUnsignedString(connection.getConnectedGUID()))
            +",\"endpoint\":"+mpJsonString(zombie.network.GameServer.server?connection.getUserName():"server")
            +",\"connectionType\":"+mpJsonString(connection.getConnectionType().toString())
            +",\"scope\":\"owned-connection-all-native-traffic\",\"headerCoverage\":\"unverified\",\"available\":"+(stats!=null);
        if(stats!=null)fields+=",\"nativeActualBytesSent\":"+stats.totalActualBytesSent+",\"nativeActualBytesReceived\":"+stats.totalActualBytesReceived
            +",\"userBytesResent\":"+stats.totalUserMessageBytesResent+",\"resendBufferBytes\":"+stats.bytesInResendBuffer
            +",\"resendBufferMessages\":"+stats.messagesInResendBuffer;
        timelineEvent("transport-stats",owner,fields);
    }
