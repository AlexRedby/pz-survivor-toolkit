    private static final java.util.WeakHashMap<zombie.network.fields.character.Prediction,java.lang.ref.WeakReference<IsoPlayer>> timelinePredictionOwners=new java.util.WeakHashMap<>();
    public static synchronized void timelineBindPrediction(IsoPlayer player) {
        if(!timelineOwner(player) || player.isLocalPlayer())return;
        try {
            var prediction=player.getNetworkCharacterAI().prediction;
            var known=timelinePredictionOwners.get(prediction);
            if(known==null || known.get()!=player)timelinePredictionOwners.put(prediction,new java.lang.ref.WeakReference<>(player));
        } catch(Throwable error){timelineError(error);}
    }
    public static synchronized void timelinePredictionUpdated(zombie.network.fields.character.Prediction prediction) {
        if(!TIMELINE)return;
        try {
            var reference=timelinePredictionOwners.get(prediction);var player=reference==null?null:reference.get();
            if(player!=null && player.getNetworkCharacterAI().prediction==prediction)timelineRemote(player,"prediction-update");
        } catch(Throwable error){timelineError(error);}
    }
    // Human updateRemotePlayer calls Prediction.update(), not animal-only updateLerp.
    // Bind by the exact enclosing owner's prediction object before that invocation.
    @Patch(className="zombie.characters.IsoPlayer",methodName="updateRemotePlayer",warmUp=true)
    public static class TimelinePredictionOwner {
        @Patch.OnEnter public static void enter(@Patch.This IsoPlayer player) {Main.timelineBindPrediction(player);}
    }
