    private record TimelineClock(long sent,long server,long processed,long observed,long before,long after,
        boolean readyBefore,boolean readyAfter,String guid,int connectionToken,boolean pending) {
        String fields() {
            return ",\"clientSendNs\":"+sent+",\"serverPreparedNs\":"+server+",\"clientProcessNs\":"+processed
                +",\"observedMonoNs\":"+observed+",\"offsetBeforeNs\":"+before+",\"offsetAfterNs\":"+after
                +",\"readyBefore\":"+readyBefore+",\"readyAfter\":"+readyAfter+",\"connectionGUID\":"+mpJsonString(guid)
                +",\"connectionToken\":"+connectionToken+",\"pendingBeforeOwner\":"+pending;
        }
    }
    private static final java.util.ArrayDeque<TimelineClock> timelinePendingClock=new java.util.ArrayDeque<>();
    private static final ThreadLocal<zombie.core.raknet.UdpConnection> timelineClockConnection=new ThreadLocal<>();
    private static int timelinePendingDropped;
    private static boolean timelineFlushingClock;
    private static java.lang.reflect.Field timelineShiftField;
    public static long timelineAppliedOffset() {
        if(!TIMELINE)return 0;
        try {
            if(timelineShiftField==null) {timelineShiftField=zombie.GameTime.class.getDeclaredField("serverTimeShift");timelineShiftField.setAccessible(true);}
            return timelineShiftField.getLong(null);
        } catch(Throwable error){timelineError(error);return 0;}
    }
    public static void timelineClockEnter(zombie.core.raknet.UdpConnection connection) {
        try {if(TIMELINE)timelineClockConnection.set(connection);}catch(Throwable error){timelineError(error);}
    }
    public static void timelineClockExit() {try{if(TIMELINE)timelineClockConnection.remove();}catch(Throwable error){timelineError(error);}}
    public static synchronized void timelineClock(long t0,long server,long t1,long before,boolean readyBefore) {
        if(!TIMELINE || timelineClosing || timelineFailed)return;
        try {
            var connection=timelineClockConnection.get();
            // Only the verified native TimeSyncPacket processing scope qualifies;
            // unrelated test/manual calls cannot fabricate a handshake receipt.
            if(connection==null || connection!=zombie.network.GameClient.connection || zombie.network.GameServer.server)return;
            var boundOwner=timelineBoundOwner==null?null:timelineBoundOwner.get();
            boolean bound=boundOwner!=null && timelineBoundConnectionToken==System.identityHashCode(connection);
            String guid=Long.toUnsignedString(connection.getConnectedGUID());
            var receipt=new TimelineClock(t0,server,t1,System.nanoTime(),before,timelineAppliedOffset(),readyBefore,
                zombie.GameTime.getServerTimeShiftIsSet(),guid,System.identityHashCode(connection),!bound);
            // Preserve startup evidence without opening a file or inventing an owner.
            // Later owner-bound events flush these bounded, connection-tagged observations.
            if(timelinePendingClock.size()==256){timelinePendingClock.removeFirst();timelinePendingDropped++;}
            timelinePendingClock.addLast(receipt);
            if(bound)timelineFlushClock(boundOwner);
        } catch(Throwable error){timelineError(error);}
    }
    private static void timelineFlushClock(IsoPlayer owner) {
        if(timelineFlushingClock || zombie.network.GameServer.server || timelinePendingClock.isEmpty())return;
        timelineFlushingClock=true;
        try {
            while(!timelinePendingClock.isEmpty())timelineEvent("clock-sync",owner,timelinePendingClock.removeFirst().fields()
                +",\"pendingDroppedCount\":"+timelinePendingDropped);
        } finally {timelineFlushingClock=false;}
    }
    @Patch(className="zombie.network.packets.service.TimeSyncPacket",methodName="processClient",warmUp=true)
    public static class TimelineTimeSyncScope {
        @Patch.OnEnter
        public static void enter(@Patch.Argument(0) zombie.core.raknet.UdpConnection connection) {Main.timelineClockEnter(connection);}
        @Patch.OnExit(onThrowable=Throwable.class,suppress=Throwable.class)
        public static void exit() {Main.timelineClockExit();}
    }
    @Patch(className="zombie.GameTime",methodName="syncServerTime",warmUp=true)
    public static class TimelineTimeSync {
        @Patch.OnEnter
        public static void enter(@Patch.Local("before") long before,@Patch.Local("readyBefore") boolean readyBefore) {
            before=Main.timelineAppliedOffset();readyBefore=zombie.GameTime.getServerTimeShiftIsSet();
        }
        @Patch.OnExit(suppress=Throwable.class)
        public static void exit(@Patch.Argument(0) long sent,@Patch.Argument(1) long server,@Patch.Argument(2) long processed,
            @Patch.Local("before") long before,@Patch.Local("readyBefore") boolean readyBefore) {
            Main.timelineClock(sent,server,processed,before,readyBefore);
        }
    }

    private static java.lang.ref.WeakReference<IsoPlayer> timelineCameraOwner;
    private static boolean timelineCloseCamera() {
        return TIMELINE && "true".equals(System.getenv("PZ_CART_INVENTORY_EQUIP"));
    }
    public static void timelinePan(zombie.iso.PlayerCamera camera) {
        if(!timelineCloseCamera())return;
        try {
            var self=IsoPlayer.getInstance();var owner=timelineCameraOwner==null?null:timelineCameraOwner.get();
            if(self==null || !self.isLocalPlayer() || !"client2".equals(self.getUsername()) || owner==null
                || owner==self || !"client1".equals(owner.getUsername()) || camera!=zombie.iso.IsoCamera.cameras[0])return;
            if(zombie.iso.IsoCamera.getCameraCharacter()!=self)throw new IllegalStateException("Observer camera identity changed");
            float dx=zombie.iso.IsoUtils.XToScreen(owner.getX(),owner.getY(),owner.getZ(),0)
                -zombie.iso.IsoUtils.XToScreen(self.getX(),self.getY(),self.getZ(),0);
            float dy=zombie.iso.IsoUtils.YToScreen(owner.getX(),owner.getY(),owner.getZ(),0)
                -zombie.iso.IsoUtils.YToScreen(self.getX(),self.getY(),self.getZ(),0);
            if(!Float.isFinite(dx+dy) || Math.hypot(owner.getX()-self.getX(),owner.getY()-self.getY())>16
                || Math.abs(owner.getZ()-self.getZ())>.25f)throw new IllegalStateException("Framing target left owned fixture pad");
            // Native getOffX/Y and model-view projection consume these same pan
            // offsets; the local camera character and player index stay native.
            camera.rightClickX=camera.rightClickTargetX=dx;
            camera.rightClickY=camera.rightClickTargetY=dy;
        } catch(Throwable error){timelineError(error);}
    }
    @Patch(className="zombie.iso.PlayerCamera",methodName="update",warmUp=true)
    public static class TimelineCameraPan {
        @Patch.OnExit(suppress=Throwable.class)
        public static void exit(@Patch.This zombie.iso.PlayerCamera camera) {Main.timelinePan(camera);}
    }
