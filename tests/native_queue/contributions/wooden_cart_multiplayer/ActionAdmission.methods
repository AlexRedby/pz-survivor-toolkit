        @Patch.OnExit(onThrowable=Throwable.class,suppress=Throwable.class) public static void exit(@Patch.Argument(0) zombie.core.network.ByteBufferReader reader,@Patch.Argument(1) zombie.network.IConnection connection,@Patch.Local("admissionParse") ActionAdmissionParseScope scope,@Patch.Thrown Throwable failure){Main.actionAdmissionParseExit(scope,failure);}
    }
