        @Patch.OnExit(onThrowable=Throwable.class,suppress=Throwable.class) public static void exit(@Patch.Argument(0) zombie.network.PacketTypes.PacketType type,@Patch.Argument(1) zombie.core.raknet.UdpConnection connection,@Patch.Local("admissionProcess") ActionAdmissionScope scope,@Patch.Thrown Throwable failure){Main.actionAdmissionProcessExit(scope,failure);}
