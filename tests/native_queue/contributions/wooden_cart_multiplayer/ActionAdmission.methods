    public static class ActionAdmissionGeneralProcess {
        @Patch.OnEnter public static void enter(@Patch.This zombie.network.packets.GeneralActionPacket packet,@Patch.Argument(0) zombie.network.PacketTypes.PacketType type,@Patch.Argument(1) zombie.core.raknet.UdpConnection connection,@Patch.Local("admissionProcess") ActionAdmissionScope scope){scope=Main.actionAdmissionProcessEnter(packet,type,connection);}
        @Patch.OnExit(onThrowable=Throwable.class,suppress=Throwable.class) public static void exit(@Patch.Argument(0) zombie.network.PacketTypes.PacketType type,@Patch.Argument(1) zombie.core.raknet.UdpConnection connection,@Patch.Local("admissionProcess") ActionAdmissionScope scope,@Patch.Thrown Throwable failure){Main.actionAdmissionProcessExit(scope,failure);Main.actionAdmissionSweep("native-remove");}
