    // Explicit disposable experiment only. Ordinary cart_timeline remains passive.
    private static final boolean TIME_ALIGNMENT="true".equals(System.getenv("PZ_CART_TIME_ALIGNMENT"));
    public static final class TimelineClockSchedule {
        public static final int CAP=14;
        private long connection,actor,start,last;
        private int cart,count;
        private double previousElapsed=-1;
        private boolean closed;
        public boolean due(long now,long endpoint,long owner,int item,double elapsed) {
            if(closed)return false;
            if(!Double.isFinite(elapsed) || elapsed<0 || elapsed>26000 || endpoint<=0 || owner<=0) {closed=true;return false;}
            if(count==0){connection=endpoint;actor=owner;cart=item;start=now;}
            else if(endpoint!=connection || owner!=actor || item!=cart || now<last || elapsed<previousElapsed) {closed=true;return false;}
            if(now-start<0 || now-start>32_000_000_000L || count>=CAP){closed=true;return false;}
            previousElapsed=elapsed;
            if(count>0 && now-last<2_000_000_000L)return false;
            last=now;count++;return true;
        }
        public void prepared(long now){if(count>0 && !closed){if(now<last)closed=true;else last=now;}}
        public int count(){return count;}
        public boolean closed(){return closed;}
        public void stop(){closed=true;}
    }
    private static final TimelineClockSchedule timelineClockSchedule=new TimelineClockSchedule();
    private static final ThreadLocal<Boolean> timelineFixtureClock=new ThreadLocal<>();
    private record TimelineClockRequest(long sent,long observed,long connection,String guid,int token,long ordinal,String origin,int fixtureOrdinal) {
        String fields() {
            return ",\"nativeProcessEpoch\":"+mpJsonString(nativeTimeProcess)+",\"clientSendNs\":"+sent
                +",\"observedMonoNs\":"+observed+",\"connectionEpoch\":"+connection+",\"connectionGUID\":"+mpJsonString(guid)
                +",\"connectionToken\":"+token+",\"clockRequestOrdinal\":"+ordinal+",\"clockRequestOrigin\":"+mpJsonString(origin)+",\"fixtureRequestOrdinal\":"+fixtureOrdinal;
        }
    }
    private record TimelineClockKey(long connection,long sent) {}
    private static final java.util.LinkedHashMap<TimelineClockKey,TimelineClockRequest> timelineClockRequests=new java.util.LinkedHashMap<>();
    private static final java.util.ArrayDeque<TimelineClockRequest> timelinePendingRequests=new java.util.ArrayDeque<>();
    private static long timelineRequestOrdinal;
    private static int timelineRequestDropped;
    private static java.lang.reflect.Field timelineClockClientTimeField;
    public static synchronized void timelineClockRequested(zombie.network.packets.service.TimeSyncPacket packet) {
        if(!TIMELINE || timelineClosing || timelineFailed || zombie.network.GameServer.server || !zombie.network.GameClient.client)return;
        try {
            var connection=zombie.network.GameClient.connection;if(connection==null)return;
            if(timelineClockClientTimeField==null){timelineClockClientTimeField=packet.getClass().getDeclaredField("clientTime");timelineClockClientTimeField.setAccessible(true);}
            long sent=timelineClockClientTimeField.getLong(packet),epoch=nativeTimeIdentity(connection,false);
            var request=new TimelineClockRequest(sent,System.nanoTime(),epoch,Long.toUnsignedString(connection.getConnectedGUID()),
                System.identityHashCode(connection),++timelineRequestOrdinal,Boolean.TRUE.equals(timelineFixtureClock.get())?"fixture":"native",
                Boolean.TRUE.equals(timelineFixtureClock.get())?timelineClockSchedule.count():0);
            if(request.fixtureOrdinal()>0)timelineClockSchedule.prepared(sent);
            var key=new TimelineClockKey(epoch,sent);
            if(timelineClockRequests.containsKey(key))throw new IllegalStateException("Duplicate native TimeSync request identity");
            if(timelineClockRequests.size()==256){timelineClockRequests.remove(timelineClockRequests.keySet().iterator().next());timelineRequestDropped++;}
            if(timelinePendingRequests.size()==256){timelinePendingRequests.removeFirst();timelineRequestDropped++;}
            timelineClockRequests.put(key,request);timelinePendingRequests.addLast(request);
            var owner=timelineBoundOwner==null?null:timelineBoundOwner.get();
            if(owner!=null && timelineBoundConnectionToken==System.identityHashCode(connection))timelineFlushClock(owner);
        }catch(Throwable error){timelineError(error);}
    }
    private static String timelineClockRequestFields(zombie.core.raknet.UdpConnection connection,long sent) {
        long epoch=nativeTimeIdentity(connection,false);
        var request=timelineClockRequests.get(new TimelineClockKey(epoch,sent));
        return ",\"nativeProcessEpoch\":"+mpJsonString(nativeTimeProcess)+",\"clockRequestConnectionEpoch\":"+epoch
            +",\"clockRequestObserved\":"+(request!=null)+",\"clockRequestOrdinal\":"+(request==null?0:request.ordinal())
            +",\"clockRequestOrigin\":"+mpJsonString(request==null?"unobserved":request.origin())+",\"clockRequestDropped\":"+timelineRequestDropped;
    }
    private static void timelineFlushRequests(IsoPlayer owner) {
        while(!timelinePendingRequests.isEmpty())timelineEvent("clock-request",owner,timelinePendingRequests.removeFirst().fields()
            +",\"clockRequestDropped\":"+timelineRequestDropped);
    }
    @Patch(className="zombie.network.packets.service.TimeSyncPacket",methodName="setData",warmUp=true)
    public static class TimelineClockRequestStamp {
        @Patch.OnExit(suppress=Throwable.class)
        public static void exit(@Patch.This zombie.network.packets.service.TimeSyncPacket packet){Main.timelineClockRequested(packet);}
    }
    @LuaMethod(name="cartMPTimingSample",global=true)
    public static boolean timelineSampleClock(IsoPlayer owner,int cart,double elapsed) {
        if(!TIME_ALIGNMENT)return false;
        if(timelineClosing || timelineFailed){timelineClockSchedule.stop();return false;}
        var self=IsoPlayer.getInstance();var connection=zombie.network.GameClient.connection;
        if(!TIMELINE || zombie.network.GameServer.server || !zombie.network.GameClient.client || connection==null
            || !zombie.network.GameClient.instance.connected || self==null || !self.isLocalPlayer()
            || !("client1".equals(self.getUsername()) || "client2".equals(self.getUsername()))
            || Thread.currentThread()!=zombie.GameWindow.gameThread || timelineClockConnection.get()!=null
            || !timelineOwner(owner) || owner.isDead() || owner.getPrimaryHandItem()==null
            || owner.getPrimaryHandItem().getID()!=cart || owner.getSecondaryHandItem()!=owner.getPrimaryHandItem()) {
            timelineClockSchedule.stop();throw new IllegalStateException("Owned game-thread cart timing fixture required");
        }
        long requestAt=System.nanoTime();
        if(!timelineClockSchedule.due(requestAt,nativeTimeIdentity(connection,false),nativeTimeIdentity(owner,true),cart,elapsed))return false;
        timelineEvent("clock-experiment-request",owner,",\"fixtureRequestOrdinal\":"+timelineClockSchedule.count()
            +",\"fixtureRequestMonoNs\":"+requestAt+",\"fixtureRequestCap\":"+TimelineClockSchedule.CAP+",\"fixtureElapsedMs\":"+elapsed
            +",\"nativeProcessEpoch\":"+mpJsonString(nativeTimeProcess)+",\"connectionEpoch\":"+nativeTimeIdentity(connection,false));
        if(timelineFailed)return false;
        timelineFixtureClock.set(true);
        try {zombie.network.packets.INetworkPacket.send(connection,zombie.network.PacketTypes.PacketType.TimeSync);}
        finally {timelineFixtureClock.remove();}
        return true;
    }
