    private static boolean observerEnabled(){return OBSERVER_ASSOCIATION && ACTION_ADMISSION && LEASE_CONTROL && TIMELINE && !leaseControlFailed && !actionAdmissionFailed && !observerAssociationFailed;}
    private static void observerError(Throwable error){observerAssociationFailed=true;System.err.println("[CART_OBSERVER] ERROR "+error);Main.timelineError(new IllegalStateException("Diagnostic observer association failed",error));}
    /** Exact, bounded textual identity. No timestamps, action names, models or item IDs participate. */
    public static ObserverTag observerAssociationTag(String text) {
        if(text==null || text.length()>240)return null;
        String[] fields=text.split("\\|",-1);if(fields.length!=8 || !"1".equals(fields[0]))return null;
        try {
            if(!java.util.UUID.fromString(fields[1]).toString().equals(fields[1]))return null;
            long[] values=new long[6];for(int i=0;i<6;i++){
                if(!fields[i+2].matches("[1-9][0-9]{0,15}"))return null;
                values[i]=Long.parseLong(fields[i+2]);if(values[i]>9007199254740991L)return null;
            }
            return new ObserverTag(text.substring(0,text.lastIndexOf('|')),text,fields[1],values[0],values[1],values[2],values[3],values[4],values[5]);
        }catch(IllegalArgumentException invalid){return null;}
    }
    private static zombie.network.PZNetKahluaTableImpl observerParams(zombie.network.packets.actions.StatePacket packet)throws ReflectiveOperationException {
        var field=observerParamsField;if(field==null){field=zombie.network.packets.actions.StatePacket.class.getDeclaredField("params");field.setAccessible(true);observerParamsField=field;}
        return (zombie.network.PZNetKahluaTableImpl)field.get(packet);
    }
    private static ObserverTag observerTag(zombie.network.packets.actions.StatePacket packet)throws ReflectiveOperationException {
        Object value=observerParams(packet).rawget(OBSERVER_MARKER);return value instanceof String text?observerAssociationTag(text):null;
    }
    private static String observerRole(){if(zombie.network.GameServer.server)return "server";var p=IsoPlayer.getInstance();return p==null?"unavailable":p.getUsername();}
    private static boolean observerOwner(ObserverSource source,boolean returned) {
        var owner=source.owner.get();var action=source.action.get();var connection=source.connection.get();var table=source.table.get();
        if(source.ended || (returned && !source.returned) || !leaseControlOwnedClient() || owner!=IsoPlayer.getInstance()
            || action==null || table==null || action.chr!=owner || action.getTable()!=table || table.rawget("character")!=owner || table.rawget("action")!=action
            || zombie.network.GameClient.connection!=connection || owner.getCharacterActions().isEmpty() || owner.getCharacterActions().get(0)!=action)return false;
        var engine=zombie.network.GameClient.instance.udpEngine;
        return connection!=null && engine!=null && engine.getActiveConnection(connection.getConnectedGUID())==connection;
    }
    public static ObserverSource observerBegin(zombie.characters.CharacterTimedActions.LuaTimedActionNew action) {
        if(!observerEnabled())return null;
        try {
            if(!leaseControlOwnedClient() || !(action.chr instanceof IsoPlayer owner) || owner!=IsoPlayer.getInstance()
                || action.getTable()==null || !(action.getTable().rawget("Type") instanceof String kind) || !actionAdmissionKind(kind))return null;
            var record=new ObserverSource(action,owner,zombie.network.GameClient.connection,observerSequence.incrementAndGet());
            if(!observerOwner(record,false))return null;
            var previous=observerSources.get(action);if(previous!=null && !previous.ended){previous.ended=true;observerSourceLog("source-end",previous,"source-restarted",true);}
            observerSources.put(action,record);observerSourceLog("source-begin",record,"native-start-enter",true);return record;
        }catch(Throwable error){observerError(error);return null;}
    }
    public static void observerBeginExit(ObserverSource source,Throwable failure) {
        if(source==null)return;
        try{if(failure==null)source.returned=true;else{source.ended=true;observerSourceLog("source-end",source,"start-threw",false);}}
        catch(Throwable error){observerError(error);}
    }
    public static void observerSourceEnd(zombie.characters.CharacterTimedActions.LuaTimedActionNew action,String reason,Throwable failure) {
        if(!observerEnabled())return;
        try{var source=observerSources.get(action);if(source!=null && !source.ended){source.ended=true;observerSourceLog("source-end",source,reason,failure==null);}}
        catch(Throwable error){observerError(error);}
    }
    @LuaMethod(name="cartObserverSource",global=true)
    public static String cartObserverSource(Object actualNative) {
        if(!observerEnabled() || !(actualNative instanceof zombie.characters.CharacterTimedActions.LuaTimedActionNew action))return null;
        try{var source=observerSources.get(action);if(source!=null && observerOwner(source,true)){observerSourceLog("source-capture",source,"exact-current-native",true);return source.life;}return null;}
        catch(Throwable error){observerError(error);return null;}
    }
    public static void observerSet(zombie.network.packets.actions.StatePacket packet,Object[] args,Throwable failure) {
        if(!observerEnabled() || failure!=null)return;
        try {
            observerPackets.remove(packet);
            if(args.length!=3 || args[1]!=zombie.ai.states.PlayerActionsState.instance() || !(args[0] instanceof IsoPlayer owner)
                || !owner.isLocalPlayer() || owner.getCharacterActions().isEmpty()
                || !(owner.getCharacterActions().get(0) instanceof zombie.characters.CharacterTimedActions.LuaTimedActionNew action))return;
            var source=observerSources.get(action);if(source==null || source.owner.get()!=owner || !observerOwner(source,false))return;
            var params=observerParams(packet);
            if(params.rawget(OBSERVER_MARKER)!=null)throw new IllegalStateException("Diagnostic State marker key collision");
            var tag=observerAssociationTag(source.life+"|"+observerSequence.incrementAndGet());
            if(tag==null)throw new IllegalStateException("Diagnostic State marker encoding failed");
            params.rawset(OBSERVER_MARKER,tag.text());
            var record=new ObserverPacket(packet,owner,tag);record.sourceValidated=true;observerPackets.put(packet,record);
            observerLog("state-set",record,null,0,"native-set-data",true,0,0,0,0,"",0);
        }catch(Throwable error){observerError(error);}
    }
    public static ObserverParse observerParseEnter(zombie.core.network.ByteBufferReader reader,zombie.network.IConnection connection) {
        if(!observerEnabled())return null;
        try {
            var ingress=leaseControlIngresses.get(reader);
            if(ingress==null || ingress.transport().type()!=zombie.network.PacketTypes.PacketType.State.getId()
                || ingress.transport().connection().get()!=connection || !leaseControlCurrent(ingress.transport(),zombie.network.GameServer.server))ingress=null;
            return new ObserverParse(reader.position(),ingress);
        }catch(Throwable error){observerError(error);return null;}
    }
    public static void observerParsed(zombie.network.packets.actions.StatePacket packet,zombie.core.network.ByteBufferReader reader,ObserverParse scope,Throwable failure) {
        if(scope==null)return;
        try {
            observerPackets.remove(packet);if(failure!=null)return;var tag=observerTag(packet);if(tag==null)return;
            if(!(packet.getCharacter() instanceof IsoPlayer owner) || packet.getState()!=zombie.ai.states.PlayerActionsState.instance())return;
            var record=new ObserverPacket(packet,owner,tag);record.ingress=scope.ingress();record.receive=observerSequence.incrementAndGet();observerPackets.put(packet,record);
            observerLog("state-parse",record,null,0,record.ingress==null?"ingress-unavailable":"native-parse",true,scope.begin(),reader.position(),reader.position()-scope.begin(),0,"",0);
        }catch(Throwable error){observerError(error);}
    }
    private static boolean observerTransport(ObserverPacket record) {
        return record!=null && record.ingress!=null && leaseControlCurrent(record.ingress.transport(),zombie.network.GameServer.server);
    }
    private static boolean observerServerActor(ObserverPacket record,zombie.core.raknet.UdpConnection connection)throws ReflectiveOperationException {
        var player=record.owner.get();var packet=record.packet.get();
        if(player==null || packet==null || !observerTransport(record) || record.ingress.transport().connection().get()!=connection || !actionAdmissionRegistered(player,connection))return false;
        var id=observerCharacterField;if(id==null){id=zombie.network.packets.actions.StatePacket.class.getDeclaredField("characterId");id.setAccessible(true);observerCharacterField=id;}Object character=id.get(packet);
        var slot=observerPlayerField;if(slot==null){slot=zombie.network.fields.character.CharacterID.class.getDeclaredField("playerId");slot.setAccessible(true);observerPlayerField=slot;}var wire=(zombie.network.fields.character.PlayerID)slot.get(character);
        return wire.getPlayer()==player && wire.getID()==player.getOnlineID() && wire.getPlayerIndex()==player.playerIndex;
    }
    public static ObserverProcess observerProcessEnter(zombie.network.packets.actions.StatePacket packet,zombie.core.raknet.UdpConnection connection,boolean server) {
        if(!observerEnabled())return null;
        var previous=observerProcessing.get();ObserverPacket record=null;
        try {
            record=observerPackets.get(packet);
            if(record!=null) {
                boolean valid=observerTransport(record) && record.ingress.transport().connection().get()==connection;
                if(server)record.sourceValidated=valid && observerServerActor(record,connection);
                else valid=valid && record.owner.get()!=null && !record.owner.get().isLocalPlayer()
                    && zombie.network.GameClient.IDToPlayerMap.get(record.owner.get().getOnlineID())==record.owner.get();
                record.processed=valid && (!server || record.sourceValidated);
            }
        }catch(Throwable error){observerError(error);}
        var scope=new ObserverProcess(record,server,previous);observerProcessing.set(scope);return scope;
    }
    public static void observerProcessExit(ObserverProcess scope,Throwable failure) {
        if(scope==null)return;
        try {
            var record=scope.input();if(record!=null) {
                if(failure!=null)record.processed=false;
                observerLog(scope.server()?"state-process-server":"state-process-client",record,null,record.apply,"native-process",failure==null,0,0,0,0,"",0);
                if(!scope.server() && !record.applied && !observerQueued(record))observerDiscard(record,"process-not-retained");
            }
        }catch(Throwable error){observerError(error);}
        finally{if(scope.previous()==null)observerProcessing.remove();else observerProcessing.set(scope.previous());}
    }
    private static boolean observerQueued(ObserverPacket record) {
        var packet=record.packet.get();var owner=record.owner.get();if(packet==null || owner==null || owner.getNetworkCharacterAI()==null)return false;
        var state=owner.getNetworkCharacterAI().getState();var type=packet.getState();
        return state.getEnterState(type)==packet || state.getEnterSubState(type)==packet || state.getExitState(type)==packet || state.getExitSubState(type)==packet;
    }
    public static void observerWritten(zombie.network.packets.actions.StatePacket packet,zombie.core.network.ByteBufferWriter writer,int begin,Throwable failure) {
        if(!observerEnabled())return;
        try {
            var record=observerPackets.get(packet);if(record==null || failure!=null)return;
            var send=nativeTimeSends.get(writer);var endpoint=send==null?null:send.endpoint.get();
            long connection=send==null?0:send.connection;String peer=send==null?"unavailable":send.peer;
            if(send!=null && send.thread!=Thread.currentThread().getId())throw new IllegalStateException("Foreign diagnostic State writer thread");
            if(begin<3 || (writer.bb.get(begin-3)&255)!=134 || writer.bb.getShort(begin-2)!=zombie.network.PacketTypes.PacketType.State.getId())throw new IllegalStateException("Diagnostic State write header changed");
            int end=writer.bb.position();if(end<begin || end-begin>2048)throw new IllegalStateException("Diagnostic State body exceeds capacity");
            var processing=observerProcessing.get();long parent=zombie.network.GameServer.server?record.receive:0;
            String reason=zombie.network.GameServer.server?(processing!=null && processing.input()==record?"native-relay":"retained-sync"):"native-source";
            if(endpoint!=null)observerSends.put(endpoint,new ObserverSend(record,send.generation,connection,peer,parent,begin,end,Thread.currentThread().getId()));
            observerLog("state-write",record,null,0,reason,true,begin,end,end-begin,connection,peer,send==null?0:send.generation);
        }catch(Throwable error){observerError(error);}
    }
    public static void observerSendStarted(zombie.core.raknet.UdpConnection connection) {
        if(!observerEnabled())return;
        try{observerSends.remove(connection);}catch(Throwable error){observerError(error);}
    }
    public static ObserverSend observerSendEnter(zombie.core.raknet.UdpConnection connection) {
        if(!observerEnabled())return null;
        try{var send=observerSends.get(connection);observerSends.remove(connection);if(send!=null && send.thread()!=Thread.currentThread().getId())throw new IllegalStateException("Foreign diagnostic State submission");return send;}
        catch(Throwable error){observerError(error);return null;}
    }
    public static void observerSendExit(ObserverSend send,boolean cancel,Throwable failure) {
        if(send==null)return;
        try{observerLog(cancel || failure!=null?"state-cancel":"state-submit",send.input(),null,0,cancel?"native-cancel":"native-submit",failure==null,send.begin(),send.end(),send.end()-send.begin(),send.connection(),send.peer(),send.generation());}
        catch(Throwable error){observerError(error);}
    }
    public static ObserverApply observerApplyEnter(zombie.network.packets.actions.StatePacket packet) {
        if(!observerEnabled())return null;
        var previous=observerApplying.get();var record=observerPackets.get(packet);long generation=observerSequence.incrementAndGet();
        if(record!=null)record.apply=generation;var scope=new ObserverApply(record,generation,previous);observerApplying.set(scope);return scope;
    }
    public static void observerApplyExit(ObserverApply scope,Throwable failure) {
        if(scope==null)return;
        try {
            var record=scope.input();if(record!=null){record.applied=failure==null;var actor=record.owner.get();var associated=actor==null?null:observerActors.get(actor);if(associated!=null && (associated.input!=record || associated.apply!=scope.generation()))associated=null;observerLog("state-apply",record,associated,scope.generation(),"native-apply",failure==null,0,0,0,0,"",0);
                if(failure!=null){var owner=record.owner.get();var proxy=owner==null?null:observerActors.get(owner);if(proxy!=null && proxy.apply==scope.generation()){proxy.state="stopped";proxy.reason="apply-threw";observerLog("proxy-stop",record,proxy,proxy.apply,proxy.reason,false,0,0,0,0,"",0);}}}
        }catch(Throwable error){observerError(error);}
        finally{if(scope.previous()==null)observerApplying.remove();else observerApplying.set(scope.previous());}
    }
    private static boolean observerProxyCurrent(ObserverProxy proxy) {
        var owner=proxy.owner.get();var action=proxy.proxy.get();return owner!=null && action!=null && owner.getNetworkCharacterAI()!=null && owner.getNetworkCharacterAI().getAction()==action;
    }
    private static boolean observerProxyValid(ObserverProxy proxy) {
        var owner=proxy.owner.get();return "active".equals(proxy.state) && (!"retained-params".equals(proxy.associationKind) || observerParamsHealthy()) && observerProxyCurrent(proxy) && proxy.input.applied && proxy.input.processed && observerTransport(proxy.input)
            && owner!=null && !owner.isDead() && !owner.isLocalPlayer() && zombie.network.GameClient.IDToPlayerMap.get(owner.getOnlineID())==owner;
    }
    public static void observerAction(zombie.characters.NetworkCharacterAI ai,zombie.characters.CharacterTimedActions.BaseAction action,Throwable failure) {
        if(!observerEnabled() || failure!=null)return;
        try {
            if(!(ai.getCharacter() instanceof IsoPlayer owner) || owner.isLocalPlayer() || ai.getAction()!=action)return;
            var old=observerActors.get(owner);
            if(old!=null && (action==null || old.proxy.get()!=action) && "active".equals(old.state)){old.state="replaced";old.reason="native-replacement";observerReplacement(old,action);}
            var scope=observerApplying.get();var record=scope==null?null:scope.input();
            if(record==null || record.owner.get()!=owner || !"Enter".equals(record.stage) || !record.processed || !observerTransport(record) || action==null || action.chr!=owner)return;
            var proxy=new ObserverProxy(action,owner,record,scope.generation());observerProxies.put(action,proxy);observerActors.put(owner,proxy);
            observerLog("proxy-associate",record,proxy,proxy.apply,"exact-apply-set-action",true,0,0,0,0,"",0);
        }catch(Throwable error){observerError(error);}
    }
    /** Historical input association after every native consumer read completed; never a new action grant. */
    public static void observerParamsConsumed(ObserverPacket input,IsoPlayer owner,zombie.characters.CharacterTimedActions.BaseAction action,
            long applyGeneration,long consumeGeneration,long mapEpoch,long revision) {
        if(!observerEnabled() || observerApplying.get()!=null)return;
        try {
            if(input==null || input.owner.get()!=owner || !input.applied || !input.processed || !observerTransport(input)
                || owner==null || owner.isLocalPlayer() || owner.isDead() || zombie.network.GameClient.IDToPlayerMap.get(owner.getOnlineID())!=owner
                || action==null || action.chr!=owner || owner.getNetworkCharacterAI()==null || owner.getNetworkCharacterAI().getAction()!=action
                || input.apply!=applyGeneration || !"Enter".equals(input.stage) || consumeGeneration<=0 || mapEpoch<=0 || revision<=0)return;
            var previous=observerActors.get(owner);
            if(previous!=null && previous.proxy.get()==action)return;
            if(previous!=null && "active".equals(previous.state)) {
                previous.state="replaced";previous.reason="native-replacement";observerReplacement(previous,action);
            }
            var proxy=new ObserverProxy(action,owner,input,applyGeneration,"retained-params",consumeGeneration,mapEpoch,revision);
            observerProxies.put(action,proxy);observerActors.put(owner,proxy);
            observerLog("proxy-associate",input,proxy,applyGeneration,"exact-retained-params-consumer",true,0,0,0,0,"",0);
        }catch(Throwable error){observerError(error);}
    }
    public static ObserverProxy observerStopEnter(zombie.characters.NetworkCharacterAI ai) {
        if(!observerEnabled())return null;
        try{var action=ai.getAction();return action==null?null:observerProxies.get(action);}catch(Throwable error){observerError(error);return null;}
    }
    public static void observerStopExit(ObserverProxy proxy,Throwable failure) {
        if(proxy==null)return;
        try{if("active".equals(proxy.state)){proxy.state="stopped";proxy.reason=failure==null?"native-stop":"stop-threw";observerLog("proxy-stop",proxy.input,proxy,proxy.apply,proxy.reason,failure==null,0,0,0,0,"",0);}}
        catch(Throwable error){observerError(error);}
    }
    public static ObserverQueue observerQueueBefore(java.util.LinkedList<?> queue) {
        if(!observerEnabled())return null;
        try {
            if(queue.size()>256)throw new IllegalStateException("Diagnostic State queue exceeds capacity");
            var packets=new java.util.ArrayList<zombie.network.packets.actions.StatePacket>();var records=new java.util.ArrayList<ObserverPacket>();
            for(Object value:queue)if(value instanceof zombie.network.packets.actions.StatePacket packet){var record=observerPackets.get(packet);if(record!=null){packets.add(packet);records.add(record);}}
            return new ObserverQueue(packets,records);
        }catch(Throwable error){observerError(error);return null;}
    }
    public static void observerQueueAfter(ObserverQueue before,java.util.LinkedList<?> queue,String reason) {
        if(before==null)return;
        try{for(int i=0;i<before.records().size();i++)if(!queue.contains(before.packets().get(i)))observerDiscard(before.records().get(i),reason);}
        catch(Throwable error){observerError(error);}
        finally{java.lang.ref.Reference.reachabilityFence(before);}
    }
    public static void observerDiscard(ObserverPacket record,String reason) {
        if(record==null || record.applied || record.discarded)return;record.discarded=true;observerLog("state-discard",record,null,record.apply,reason,true,0,0,0,0,"",0);
    }
    public static void observerRemoved(zombie.network.packets.actions.StatePacket packet) {
        if(!observerEnabled() || packet==null)return;
        try{observerDiscard(observerPackets.get(packet),"native-remove");}catch(Throwable error){observerError(error);}
    }
    public static java.util.ArrayList<ObserverQueue> observerResetBefore(zombie.characters.NetworkState state) {
        if(!observerEnabled())return null;
        try {
            var before=new java.util.ArrayList<ObserverQueue>();
            for(String name:new String[]{"enterStatePackets","enterSubStatePackets","exitStatePackets","exitSubStatePackets"}){
                var field=zombie.characters.NetworkState.class.getDeclaredField(name);field.setAccessible(true);var pending=observerQueueBefore((java.util.LinkedList<?>)field.get(state));if(pending!=null)before.add(pending);
            }
            return before;
        }catch(Throwable error){observerError(error);return null;}
    }
    public static void observerResetAfter(java.util.ArrayList<ObserverQueue> before,Throwable failure) {
        if(before==null)return;
        try{if(failure==null)for(var queue:before)for(var record:queue.records())observerDiscard(record,"native-reset");}
        catch(Throwable error){observerError(error);}
        finally{java.lang.ref.Reference.reachabilityFence(before);}
    }
    private static java.util.LinkedHashMap<String,Object> observerFields(ObserverPacket record,ObserverProxy proxy,long apply,String reason,boolean success,int begin,int end,int bytes,long connection,String peer,long send) {
        var fields=new java.util.LinkedHashMap<String,Object>();var tag=record==null?null:record.tag;var owner=record==null?null:record.owner.get();
        if(connection==0 && record!=null && record.ingress!=null)connection=record.ingress.transport().epoch();
        if(peer==null || peer.isEmpty())peer=record!=null && record.ingress!=null?nativeTimePeer(record.ingress.transport().connection().get(),false):"unavailable";
        fields.put("protocol",1);fields.put("diagnosticWire",true);fields.put("process",nativeTimeProcess);fields.put("role",observerRole());fields.put("owner",owner==null?-1:owner.getOnlineID());fields.put("actorEpoch",owner==null?0:nativeTimeIdentity(owner,true));fields.put("connectionEpoch",connection);fields.put("peerRole",peer);
        fields.put("sourceLife",tag==null?"":tag.life());fields.put("stateTag",tag==null?"":tag.text());fields.put("sourceProcess",tag==null?"":tag.process());fields.put("sourceActorEpoch",tag==null?0:tag.actor());fields.put("sourceConnectionEpoch",tag==null?0:tag.connection());fields.put("sourceNativeEpoch",tag==null?0:tag.action());fields.put("sourceTableEpoch",tag==null?0:tag.table());fields.put("sourceBeginGeneration",tag==null?0:tag.begin());fields.put("stateGeneration",tag==null?0:tag.state());
        fields.put("packetEpoch",record==null?0:record.epoch);fields.put("ingressGeneration",record==null || record.ingress==null?0:record.ingress.generation());fields.put("receiveGeneration",record==null?0:record.receive);fields.put("sendGeneration",send);fields.put("parentReceiveGeneration",record!=null && zombie.network.GameServer.server?record.receive:0);
        fields.put("associationKind",proxy==null?"unavailable":proxy.associationKind);fields.put("actionEpoch",proxy==null?0:proxy.actionEpoch);
        fields.put("consumeGeneration",proxy==null?0:proxy.consumeGeneration);fields.put("paramsMapEpoch",proxy==null?0:proxy.paramsMapEpoch);fields.put("paramsRevision",proxy==null?0:proxy.paramsRevision);
        fields.put("proxyEpoch",proxy==null?0:proxy.epoch);fields.put("applyGeneration",apply);fields.put("proxyState",proxy==null?"unavailable":proxy.state);fields.put("proxyCurrent",proxy!=null && observerProxyCurrent(proxy));fields.put("associationValid",proxy!=null && observerProxyValid(proxy));fields.put("transportValidated",record!=null && (observerTransport(record) || (record.ingress==null && connection>0 && connection==record.tag.connection() && zombie.network.GameClient.connection!=null && nativeTimeIdentity(zombie.network.GameClient.connection,false)==connection && leaseControlOwnedClient())));fields.put("sourceValidated",record!=null && record.sourceValidated);fields.put("stage",record==null?"unavailable":record.stage);fields.put("reason",reason);fields.put("packetBytes",bytes);fields.put("bodyBegin",begin);fields.put("bodyEnd",end);fields.put("success",success);fields.put("monoNs",System.nanoTime());fields.put("wallMs",System.currentTimeMillis());return fields;
    }
    private static void observerWrite(String event,java.util.Map<String,Object> fields) {
        var json=new StringBuilder("{\"event\":").append(mpJsonString(event));
        for(var entry:fields.entrySet()) {
            Object value=entry.getValue();json.append(',').append(mpJsonString(entry.getKey())).append(':')
                .append(value instanceof Number || value instanceof Boolean?value:mpJsonString((String)value));
        }
        System.out.println("[CART_OBSERVER] "+json.append('}'));
    }
    /** Diagnostic call provenance only. A replacement is never rebound by its stack or timing. */
    private static void observerReplacement(ObserverProxy old,zombie.characters.CharacterTimedActions.BaseAction replacement) {
        var fields=observerFields(old.input,old,old.apply,old.reason,true,0,0,0,0,"",0);
        var scope=observerApplying.get();
        fields.put("replacementActionEpoch",nativeTimeIdentity(replacement,false));
        fields.put("replacementApplyGeneration",scope==null?0:scope.generation());
        fields.put("replacementTaggedApply",scope!=null && scope.input()!=null);
        fields.put("replacementStack",StackWalker.getInstance().walk(frames->frames.skip(1).limit(16)
            .map(frame->frame.getClassName()+"."+frame.getMethodName()).collect(java.util.stream.Collectors.joining("|"))));
        observerWrite("proxy-replaced",fields);
    }
    private static void observerLog(String event,ObserverPacket record,ObserverProxy proxy,long apply,String reason,boolean success,int begin,int end,int bytes,long connection,String peer,long send) {
        observerWrite(event,observerFields(record,proxy,apply,reason,success,begin,end,bytes,connection,peer,send));
    }
    private static void observerSourceLog(String event,ObserverSource source,String reason,boolean success) {
        var tag=observerAssociationTag(source.life+"|1");var owner=source.owner.get();var fields=observerFields(null,null,0,reason,success,0,0,0,source.connection.get()==null?0:nativeTimeIdentity(source.connection.get(),false),"server",0);
        fields.put("owner",owner==null?-1:owner.getOnlineID());fields.put("actorEpoch",owner==null?0:nativeTimeIdentity(owner,true));fields.put("sourceLife",source.life);fields.put("sourceProcess",nativeTimeProcess);fields.put("sourceActorEpoch",tag.actor());fields.put("sourceConnectionEpoch",tag.connection());fields.put("sourceNativeEpoch",tag.action());fields.put("sourceTableEpoch",tag.table());fields.put("sourceBeginGeneration",source.begin);fields.put("sourceValidated",true);
        var json=new StringBuilder("{\"event\":").append(mpJsonString(event));for(var entry:fields.entrySet()){Object value=entry.getValue();json.append(',').append(mpJsonString(entry.getKey())).append(':').append(value instanceof Number || value instanceof Boolean?value:mpJsonString((String)value));}System.out.println("[CART_OBSERVER] "+json.append('}'));
    }
    /** Current proxy input only. A stopped retained pointer grants no active association. */
    public static String observerAssociationSnapshot(IsoPlayer owner) {
        if(!OBSERVER_ASSOCIATION)return "";
        try {
            var proxy=observerEnabled() && owner!=null?observerActors.get(owner):null;var record=proxy==null?null:proxy.input;
            return ",\"observerVersion\":2,\"observerDiagnosticWire\":true,\"observerProcess\":"+mpJsonString(nativeTimeProcess)
                +",\"observerSourceLife\":"+mpJsonString(record==null?"":record.tag.life())+",\"observerStateTag\":"+mpJsonString(record==null?"":record.tag.text())
                +",\"observerStateGeneration\":"+(record==null?0:record.tag.state())+",\"observerPacketEpoch\":"+(record==null?0:record.epoch)
                +",\"observerIngressGeneration\":"+(record==null || record.ingress==null?0:record.ingress.generation())+",\"observerReceiveGeneration\":"+(record==null?0:record.receive)
                +",\"observerApplyGeneration\":"+(proxy==null?0:proxy.apply)+",\"observerProxyEpoch\":"+(proxy==null?0:proxy.epoch)
                +",\"observerAssociationKind\":"+mpJsonString(proxy==null?"unavailable":proxy.associationKind)
                +",\"observerConsumeGeneration\":"+(proxy==null?0:proxy.consumeGeneration)+",\"observerParamsMapEpoch\":"+(proxy==null?0:proxy.paramsMapEpoch)
                +",\"observerParamsRevision\":"+(proxy==null?0:proxy.paramsRevision)
                +",\"observerProxyState\":"+mpJsonString(proxy==null?"unavailable":proxy.state)+",\"observerProxyCurrent\":"+(proxy!=null && observerProxyCurrent(proxy))
                +",\"observerAssociationValid\":"+(proxy!=null && observerProxyValid(proxy))+",\"observerReason\":"+mpJsonString(proxy==null?"unavailable":proxy.reason);
        }catch(Throwable error){observerError(error);return ",\"observerVersion\":2,\"observerDiagnosticWire\":true,\"observerAssociationValid\":false,\"observerReason\":\"diagnostic-failed\"";}
    }
