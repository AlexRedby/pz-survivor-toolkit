    // Diagnostic only; pinned B42.21 audited setter/load/death/removal boundaries.
    private static final boolean LEASE_LIFETIME="true".equals(System.getenv("PZ_CART_LEASE_LIFETIME"));
    private static final Object equipmentLifetimeLock=new Object();
    private static final NativeWeakMap<IsoPlayer,EquipmentLife> equipmentLives=new NativeWeakMap<>();
    private static final NativeWeakMap<zombie.core.raknet.UdpConnection,Boolean> equipmentRetiredConnections=new NativeWeakMap<>();
    private static final java.util.ArrayList<EquipmentLife> equipmentLifetimeRecords=new java.util.ArrayList<>();
    private static volatile boolean equipmentLifetimeFailed;
    private static long equipmentLifetimeTraceCount,equipmentLifetimeMutationSerial,equipmentLifetimeParseSerial,equipmentLifetimeIssuedCount;
    private static final ThreadLocal<EquipmentParse> equipmentLifetimeParsing=new ThreadLocal<>();
    public static final class EquipmentParse {
        public final zombie.core.network.ByteBufferReader reader;
        public final zombie.core.raknet.UdpConnection connection;
        public final LeaseCommandIngress ingress;
        public final LeaseDispatchScope dispatch;
        public final EquipmentParse previous;
        public final long serial;
        public final boolean trusted;
        public IsoPlayer actor;public EquipmentLife life;
        public zombie.inventory.InventoryItem original,next;
        public long beforeRevision,beforeHardRevision;public int stage,directCalls,genericCalls;public boolean invalid;
        EquipmentParse(zombie.core.network.ByteBufferReader reader,zombie.core.raknet.UdpConnection connection,
                LeaseCommandIngress ingress,LeaseDispatchScope dispatch,EquipmentParse previous,long serial,boolean trusted){
            this.reader=reader;this.connection=connection;this.ingress=ingress;this.dispatch=dispatch;this.previous=previous;this.serial=serial;this.trusted=trusted;
        }
    }
    public static final class EquipmentLife {
        public final java.lang.ref.WeakReference<IsoPlayer> actor;public final long actorEpoch;
        public boolean born,birthPending,retiredRegistered;public long birthRemovedStamp;public String retirementReason;
        public java.lang.ref.WeakReference<zombie.core.raknet.UdpEngine> birthEngine=new java.lang.ref.WeakReference<>(null);
        public java.lang.ref.WeakReference<zombie.core.raknet.UdpConnection> birthConnection=new java.lang.ref.WeakReference<>(null);
        public final java.util.HashSet<Long> issued=new java.util.HashSet<>();
        public java.lang.ref.WeakReference<zombie.core.raknet.UdpConnection> connection=new java.lang.ref.WeakReference<>(null);
        public java.lang.ref.WeakReference<zombie.inventory.InventoryItem> primary=new java.lang.ref.WeakReference<>(null),secondary=new java.lang.ref.WeakReference<>(null);
        public long revision=1,hardRevision=1,thread;public int depth,cart,parseDepth;public boolean baseline,poisoned,retired;
        EquipmentLife(IsoPlayer actor){this(actor,nativeTimeIdentity(actor,true));}
        EquipmentLife(IsoPlayer actor,long epoch){this.actor=new java.lang.ref.WeakReference<>(actor);this.actorEpoch=epoch;}
    }
    public record EquipmentMutation(EquipmentLife life,int depth,long thread,long serial,String reason,
        zombie.inventory.InventoryItem oldPrimary,zombie.inventory.InventoryItem oldSecondary,EquipmentParse parse,EquipmentPendingBirth pending) {}
    private static boolean equipmentLifetimeEnabled(){return LEASE_LIFETIME && LEASE_CONTROL && !leaseControlFailed && !equipmentLifetimeFailed;}
    private static void equipmentLifetimeError(Throwable error){equipmentLifetimeFailed=true;System.err.println("[CART_EQUIPMENT] {\"event\":\"error\",\"reason\":"+mpJsonString(String.valueOf(error))+"}");Main.timelineError(new IllegalStateException("Native equipment lifetime observation failed",error));}
    private static void equipmentLifetimeTrace(String event,EquipmentLife life,EquipmentMutation scope,String reason,boolean success) {
        if(++equipmentLifetimeTraceCount>8192)throw new IllegalStateException("Equipment lifetime trace limit");
        var actor=life.actor.get();var primary=actor==null?null:actor.getPrimaryHandItem();var secondary=actor==null?null:actor.getSecondaryHandItem();
        var parse=scope==null?equipmentLifetimeParsing.get():scope.parse();
        boolean resnapshot="resnapshot".equals(event);
        var oldPrimary=resnapshot && parse!=null?parse.original:scope==null?primary:scope.oldPrimary();
        var oldSecondary=resnapshot && parse!=null?parse.original:scope==null?secondary:scope.oldSecondary();
        System.out.println("[CART_EQUIPMENT] {\"event\":"+mpJsonString(event)+",\"process\":"+mpJsonString(nativeTimeProcess)
            +",\"ownerID\":"+(actor==null?-1:actor.getOnlineID())+",\"actorEpoch\":"+life.actorEpoch
            +",\"connectionEpoch\":"+nativeTimeIdentity(life.connection.get(),false)+",\"revision\":"+life.revision+",\"depth\":"+life.depth
            +",\"reason\":"+mpJsonString(reason)+",\"mutationSerial\":"+(scope==null?0:scope.serial())
            +",\"hardRevision\":"+life.hardRevision+",\"parseSerial\":"+(parse==null?0:parse.serial)
            +",\"ingressGeneration\":"+(parse==null || parse.ingress==null?0:parse.ingress.generation())
            +",\"beforeRevision\":"+(parse==null?0:parse.beforeRevision)+",\"afterRevision\":"+life.revision
            +",\"certified\":"+(resnapshot && success)+",\"directCalls\":"+(parse==null?0:parse.directCalls)+",\"genericCalls\":"+(parse==null?0:parse.genericCalls)
            +",\"oldPrimaryEpoch\":"+nativeTimeIdentity(oldPrimary,false)+",\"oldSecondaryEpoch\":"+nativeTimeIdentity(oldSecondary,false)
            +",\"primaryEpoch\":"+nativeTimeIdentity(primary,false)+",\"secondaryEpoch\":"+nativeTimeIdentity(secondary,false)
            +",\"primaryID\":"+(primary==null?"null":String.valueOf(primary.getID()))+",\"secondaryID\":"+(secondary==null?"null":String.valueOf(secondary.getID()))
            +",\"success\":"+success+",\"poisoned\":"+life.poisoned+",\"retired\":"+life.retired+",\"monoNs\":"+System.nanoTime()+"}");
    }
    private static EquipmentLife equipmentLife(IsoPlayer actor,boolean create) {
        var life=equipmentLives.get(actor);
        if(life==null && create){
            // Never drop a live tombstone/order fence to admit another actor.
            if(equipmentLifetimeRecords.size()>=512)throw new IllegalStateException("Equipment lifetime ledger limit");
            life=new EquipmentLife(actor);equipmentLives.put(actor,life);equipmentLifetimeRecords.add(life);
        }
        return life;
    }
    private static boolean equipmentLifetimeCart(zombie.inventory.InventoryItem item) {
        if(item==null)return false;String type=item.getFullType();
        return "SaucedCarts.ShoppingCart".equals(type) || "SaucedWheelbarrow.WheelbarrowWood".equals(type) || "SaucedWheelbarrow.WheelbarrowMetal".equals(type);
    }
    private static void equipmentLifetimeRemember(EquipmentLife life,IsoPlayer actor) {
        var primary=actor.getPrimaryHandItem();var secondary=actor.getSecondaryHandItem();
        life.primary=new java.lang.ref.WeakReference<>(primary);life.secondary=new java.lang.ref.WeakReference<>(secondary);
        life.cart=primary==null?0:primary.getID();
    }
    private static EquipmentMutation equipmentLifetimeBegin(EquipmentLife life,String reason,boolean candidate) {
        long thread=Thread.currentThread().getId();
        var actor=life.actor.get();var pending=actor==null?null:equipmentPendingBirths.get(actor);
        if(pending!=null && pending.previous==life && !pending.invalid){
            if(pending.depth==Integer.MAX_VALUE || pending.depth>0 && pending.thread!=thread){pending.invalid=true;return null;}
            pending.depth++;pending.thread=thread;
            return new EquipmentMutation(life,pending.depth,thread,0,reason,actor.getPrimaryHandItem(),actor.getSecondaryHandItem(),null,pending);
        }
        if(life.retired || life.poisoned)return null;
        if(life.depth>0 && life.thread!=thread){life.poisoned=true;return null;}
        if(life.revision>=9007199254740991L || equipmentLifetimeMutationSerial>=9007199254740991L || life.depth==Integer.MAX_VALUE){life.poisoned=true;return null;}
        life.revision++;life.depth++;life.thread=thread;
        var parse=equipmentLifetimeParsing.get();
        if(!candidate){life.hardRevision=life.revision;if(parse!=null)parse.invalid=true;}
        var scope=new EquipmentMutation(life,life.depth,thread,++equipmentLifetimeMutationSerial,reason,
            actor==null?null:actor.getPrimaryHandItem(),actor==null?null:actor.getSecondaryHandItem(),parse,null);
        equipmentLifetimeTrace("mutation-enter",life,scope,reason,true);return scope;
    }
    /** Entry invalidation precedes native OnEquip callbacks; no new snapshot is eligible until exit. */
    public static EquipmentMutation equipmentLifetimeHands(zombie.characters.IsoGameCharacter actor,zombie.inventory.InventoryItem incoming,boolean primary) {
        if(!equipmentLifetimeEnabled() || !(actor instanceof IsoPlayer player))return null;
        try{synchronized(equipmentLifetimeLock){
            var life=equipmentLife(player,false);if(life==null)return null;
            var old=primary?player.getPrimaryHandItem():player.getSecondaryHandItem();
            if(old==incoming)return null;
            var parse=equipmentLifetimeParsing.get();boolean candidate=false;
            if(parse!=null){
                boolean direct=equipmentLifetimeDirect(primary);if(direct)parse.directCalls++;else parse.genericCalls++;
                if(parse.life==null){parse.life=life;parse.actor=player;parse.original=player.getPrimaryHandItem();parse.beforeRevision=life.revision;parse.beforeHardRevision=life.hardRevision;}
                if(parse.trusted && !parse.invalid && parse.actor==player && life.baseline && !life.retired && !life.poisoned
                    && life.depth==0 && equipmentLifetimeConnection(player)==parse.connection && life.connection.get()==parse.connection
                    && !player.isLocalPlayer() && direct){
                    if(primary && parse.stage==0 && life.parseDepth==0 && old!=null && old==player.getSecondaryHandItem()
                        && life.primary.get()==old && life.secondary.get()==old && life.cart==old.getID()
                        && incoming!=null && incoming!=old && equipmentLifetimeCart(old) && old.getWorldItem()==null
                        && incoming.getID()==old.getID() && incoming.getFullType().equals(old.getFullType()) && incoming.getWorldItem()==null){
                        parse.next=incoming;parse.stage=1;life.parseDepth++;candidate=true;
                    }else if(!primary && parse.stage==1 && life.parseDepth==1 && incoming==parse.next
                        && player.getPrimaryHandItem()==parse.next && old==parse.original){parse.stage=2;candidate=true;}
                }
                if(!candidate)parse.invalid=true;
            }
            return equipmentLifetimeBegin(life,primary?"primary":"secondary",candidate);
        }}catch(Throwable error){equipmentLifetimeError(error);return null;}
    }
    /** Loads directly write protected hand fields in both native character classes. */
    public static EquipmentMutation equipmentLifetimeLoad(zombie.characters.IsoGameCharacter actor,String reason) {
        if(!equipmentLifetimeEnabled() || !(actor instanceof IsoPlayer player))return null;
        try{synchronized(equipmentLifetimeLock){var life=equipmentLife(player,false);return life==null?null:equipmentLifetimeBegin(life,reason,false);}}
        catch(Throwable error){equipmentLifetimeError(error);return null;}
    }
    public static EquipmentMutation equipmentLifetimeOnlineID(IsoPlayer actor,short incoming) {
        return actor.getOnlineID()==incoming?null:equipmentLifetimeLoad(actor,"online-id");
    }
    /** Item ID/world transitions also invalidate tracked hands even if later restored to the old value. */
    public static java.util.ArrayList<EquipmentMutation> equipmentLifetimeItem(zombie.inventory.InventoryItem item,boolean changed,String reason) {
        if(!equipmentLifetimeEnabled() || !changed)return null;
        try{synchronized(equipmentLifetimeLock){
            var scopes=new java.util.ArrayList<EquipmentMutation>();
            for(var life:equipmentLifetimeRecords)if(life.actor.get()!=null && (life.primary.get()==item || life.secondary.get()==item)){
                var scope=equipmentLifetimeBegin(life,reason,false);if(scope!=null)scopes.add(scope);
            }
            return scopes;
        }}catch(Throwable error){equipmentLifetimeError(error);return null;}
    }
    public static void equipmentLifetimeExit(EquipmentMutation scope,Throwable failure) {
        if(scope==null)return;
        try{synchronized(equipmentLifetimeLock){
            var life=scope.life();
            if(scope.pending()!=null){
                var pending=scope.pending();
                if(failure!=null || pending.depth!=scope.depth() || pending.thread!=scope.thread() || Thread.currentThread().getId()!=scope.thread())pending.invalid=true;
                if(pending.depth>0)pending.depth--;if(pending.depth==0)pending.thread=0;return;
            }
            if(failure!=null || life.depth!=scope.depth() || life.thread!=scope.thread() || Thread.currentThread().getId()!=scope.thread()){
                life.poisoned=true;life.hardRevision=life.revision;if(scope.parse()!=null)scope.parse().invalid=true;
            }
            if(life.depth>0)life.depth--;
            if(life.depth==0){life.thread=0;var actor=life.actor.get();if(actor!=null && !life.poisoned && !life.retired)equipmentLifetimeRemember(life,actor);}
            equipmentLifetimeTrace("mutation-exit",life,scope,scope.reason(),failure==null && !life.poisoned);
        }}catch(Throwable error){equipmentLifetimeError(error);}
    }
    public static void equipmentLifetimeItemExit(java.util.ArrayList<EquipmentMutation> scopes,Throwable failure) {
        if(scopes!=null)for(int i=scopes.size()-1;i>=0;i--)equipmentLifetimeExit(scopes.get(i),failure);
    }
    public static void equipmentLifetimeRetire(zombie.characters.IsoGameCharacter actor,String reason) {
        if(!equipmentLifetimeEnabled() || !(actor instanceof IsoPlayer player))return;
        try{synchronized(equipmentLifetimeLock){var life=equipmentLife(player,true);var pending=equipmentPendingBirths.get(player);if(pending!=null)pending.invalid=true;int slot=player.playerIndex;
            life.retiredRegistered|=zombie.network.GameServer.server && !zombie.network.GameClient.client && zombie.network.GameServer.IDToPlayerMap.get(player.getOnlineID())==player
                || zombie.network.GameClient.client && !zombie.network.GameServer.server && (zombie.network.GameClient.IDToPlayerMap.get(player.getOnlineID())==player
                    || slot>=0 && slot<IsoPlayer.players.length && IsoPlayer.players[slot]==player);
            life.retired=true;if(life.retirementReason==null || !"actor-remove".equals(reason))life.retirementReason=reason;life.hardRevision=life.revision;var parse=equipmentLifetimeParsing.get();if(parse!=null)parse.invalid=true;equipmentLifetimeTrace("retire",life,null,reason,true);}}
        catch(Throwable error){equipmentLifetimeError(error);}
    }
    /** Capture the exact connection before the engine removes its GUID mapping or queues cleanup. */
    public static void equipmentLifetimeDisconnect(zombie.core.raknet.UdpEngine engine,long guid) {
        if(!equipmentLifetimeEnabled())return;
        try{synchronized(equipmentLifetimeLock){
            var connection=engine.getActiveConnection(guid);if(connection==null)return;equipmentRetiredConnections.put(connection,Boolean.TRUE);
            for(var life:equipmentLifetimeRecords)if(life.connection.get()==connection){life.retired=true;life.retirementReason="connection-remove";life.hardRevision=life.revision;equipmentLifetimeTrace("retire",life,null,"connection-remove",true);}
        }}catch(Throwable error){equipmentLifetimeError(error);}
    }
    private static zombie.core.raknet.UdpConnection equipmentLifetimeConnection(IsoPlayer player) {
        if(player==null || player.getOnlineID()<0 || player.removedFromWorldMs!=0 && !equipmentLifetimeBornAfterRemoval(player) || !player.isAlive())return null;
        zombie.core.raknet.UdpEngine engine;zombie.core.raknet.UdpConnection connection;
        if(zombie.network.GameServer.server && !zombie.network.GameClient.client){
            if(zombie.network.GameServer.IDToPlayerMap.get(player.getOnlineID())!=player)return null;
            connection=zombie.network.GameServer.getConnectionFromPlayer(player);engine=zombie.network.GameServer.udpEngine;
            int slot=player.playerIndex;if(connection==null || slot<0 || slot>=4 || connection.getPlayerAt(slot)!=player)return null;
        }else if(zombie.network.GameClient.client && !zombie.network.GameServer.server){
            if(zombie.network.GameClient.instance==null || !zombie.network.GameClient.instance.connected
                || zombie.network.GameClient.IDToPlayerMap.get(player.getOnlineID())!=player)return null;
            connection=zombie.network.GameClient.connection;engine=zombie.network.GameClient.instance.udpEngine;
        }else return null;
        return connection!=null && equipmentRetiredConnections.get(connection)==null && engine!=null && engine.getActiveConnection(connection.getConnectedGUID())==connection?connection:null;
    }
    /** Private core is separate solely to permit no-world native checks; Lua has only the validated API. */
    private static String equipmentLifetimeRead(IsoPlayer player,zombie.core.raknet.UdpConnection connection) {
        synchronized(equipmentLifetimeLock){
            equipmentLifetimeActivateBirth(player,connection);
            var life=equipmentLife(player,true);if(life.retired || life.poisoned || life.depth!=0 || life.parseDepth!=0 || equipmentLifetimeParsing.get()!=null)return null;
            var item=player.getPrimaryHandItem();var secondary=player.getSecondaryHandItem();
            if(life.baseline && (life.connection.get()!=connection || life.primary.get()!=item || life.secondary.get()!=secondary || item!=null && life.cart!=item.getID())){
                life.poisoned=true;return null; // Unobserved mutation cannot silently become a trusted new baseline.
            }
            if(item==null || item!=secondary || !equipmentLifetimeCart(item) || item.getWorldItem()!=null)return null;
            if(!life.baseline){life.baseline=true;life.connection=new java.lang.ref.WeakReference<>(connection);equipmentLifetimeRemember(life,player);equipmentLifetimeTrace("baseline",life,null,"admitted-current",true);}
            if(!life.issued.contains(life.revision)){
                if(equipmentLifetimeIssuedCount>=8192)throw new IllegalStateException("Equipment issued-lifetime limit");
                life.issued.add(life.revision);equipmentLifetimeIssuedCount++;
            }
            return "1|"+nativeTimeProcess+"|"+life.actorEpoch+"|"+nativeTimeIdentity(connection,false)+"|"+life.revision;
        }
    }
    /** Only the actual direct native parser calls qualify; Lua event reentrancy is a hard mutation. */
    private static boolean equipmentLifetimeDirect(boolean primary) {
        String method=primary?"setPrimaryHandItem":"setSecondaryHandItem";
        return StackWalker.getInstance(StackWalker.Option.RETAIN_CLASS_REFERENCE).walk(frames->frames
            .dropWhile(frame->frame.getDeclaringClass()!=zombie.characters.IsoGameCharacter.class || !frame.getMethodName().equals(method))
            .skip(1).findFirst().map(frame->frame.getDeclaringClass()==zombie.network.packets.EquipPacket.class && frame.getMethodName().equals("parse")).orElse(false));
    }
    public static EquipmentParse equipmentLifetimeParseEnter(zombie.core.network.ByteBufferReader reader,zombie.network.IConnection supplied) {
        if(!equipmentLifetimeEnabled())return null;
        EquipmentParse scope=null;
        try{synchronized(equipmentLifetimeLock){
            var previous=equipmentLifetimeParsing.get();if(previous!=null)previous.invalid=true;
            if(equipmentLifetimeParseSerial>=9007199254740991L)throw new IllegalStateException("Equipment parse serial exhausted");
            var connection=supplied instanceof zombie.core.raknet.UdpConnection udp?udp:null;
            var dispatch=leaseControlDispatch.get();var ingress=reader==null?null:leaseControlIngresses.get(reader);
            boolean trusted=previous==null && connection!=null && dispatch!=null && dispatch.reader()==reader && dispatch.ingress()==ingress
                && ingress!=null && ingress.transport().type()==zombie.network.PacketTypes.PacketType.Equip.getId()
                && ingress.transport().connection().get()==connection && leaseControlCurrent(ingress.transport(),false);
            scope=new EquipmentParse(reader,connection,ingress,dispatch,previous,++equipmentLifetimeParseSerial,trusted);
            equipmentLifetimeParsing.set(scope);return scope;
        }}catch(Throwable error){equipmentLifetimeError(error);return scope;}
    }
    public static void equipmentLifetimeParseExit(EquipmentParse scope,Throwable failure) {
        if(scope==null)return;
        try{synchronized(equipmentLifetimeLock){
            if(equipmentLifetimeParsing.get()!=scope)scope.invalid=true;
            var life=scope.life;var actor=scope.actor;
            if(life!=null){
                boolean certified=failure==null && scope.trusted && !scope.invalid && scope.stage==2 && scope.directCalls==2 && scope.genericCalls==0 && life.depth==0 && life.parseDepth==1
                    && !life.poisoned && !life.retired && life.hardRevision==scope.beforeHardRevision && actor!=null && equipmentLifetimeConnection(actor)==scope.connection
                    && actor.getPrimaryHandItem()==scope.next && actor.getSecondaryHandItem()==scope.next
                    && scope.original!=null && scope.next!=null && scope.original!=scope.next
                    && scope.original.getID()==scope.next.getID() && scope.original.getFullType().equals(scope.next.getFullType())
                    && scope.original.getWorldItem()==null && scope.next.getWorldItem()==null && equipmentLifetimeCart(scope.next)
                    && scope.ingress!=null && leaseControlDispatch.get()==scope.dispatch && leaseControlIngresses.get(scope.reader)==scope.ingress
                    && leaseControlCurrent(scope.ingress.transport(),false);
                if(!certified)life.hardRevision=life.revision;
                if(life.parseDepth>0)life.parseDepth--;
                if(failure!=null){life.poisoned=true;scope.invalid=true;}
                equipmentLifetimeTrace("resnapshot",life,null,"remote-equip-resnapshot",certified);
            }
        }}catch(Throwable error){equipmentLifetimeError(error);}
        finally{if(scope.previous==null)equipmentLifetimeParsing.remove();else equipmentLifetimeParsing.set(scope.previous);}
    }
    /** Repeatable local certificate; no authority, close fence, sequence or timestamp is changed. */
    @LuaMethod(name="cartLeaseResnapshot",global=true)
    public static boolean cartLeaseResnapshot(IsoPlayer player,String previousLifetime) {
        if(!equipmentLifetimeEnabled() || previousLifetime==null || previousLifetime.length()>160)return false;
        try{synchronized(equipmentLifetimeLock){
            var connection=equipmentLifetimeConnection(player);var life=player==null?null:equipmentLife(player,false);
            if(connection==null || life==null || !life.baseline || equipmentLifetimeRead(player,connection)==null)return false;
            String prefix="1|"+nativeTimeProcess+"|"+life.actorEpoch+"|"+nativeTimeIdentity(connection,false)+"|";
            if(!previousLifetime.startsWith(prefix))return false;String field=previousLifetime.substring(prefix.length());
            if(!field.matches("[1-9][0-9]{0,15}"))return false;
            long revision=Long.parseLong(field);
            return revision<=9007199254740991L && life.issued.contains(revision) && revision>=life.hardRevision && revision<life.revision;
        }}catch(Throwable error){equipmentLifetimeError(error);return false;}
    }
    public static final class EquipmentBirth {
        final zombie.util.AddCoopPlayer task;final IsoPlayer actor;final zombie.core.raknet.UdpEngine engine;
        final zombie.core.raknet.UdpConnection connection;final EquipmentBirth previous;EquipmentPendingBirth born;
        EquipmentBirth(zombie.util.AddCoopPlayer task,IsoPlayer actor,zombie.core.raknet.UdpEngine engine,zombie.core.raknet.UdpConnection connection,EquipmentBirth previous){
            this.task=task;this.actor=actor;this.engine=engine;this.connection=connection;this.previous=previous;
        }
    }
    public static final class EquipmentPendingBirth {
        final EquipmentLife previous;final long epoch,removedStamp;
        final java.lang.ref.WeakReference<zombie.core.raknet.UdpEngine> engine;
        final java.lang.ref.WeakReference<zombie.core.raknet.UdpConnection> connection;
        boolean invalid;int depth;long thread;
        EquipmentPendingBirth(EquipmentLife previous,long epoch,long stamp,zombie.core.raknet.UdpEngine engine,zombie.core.raknet.UdpConnection connection){
            this.previous=previous;this.epoch=epoch;this.removedStamp=stamp;this.engine=new java.lang.ref.WeakReference<>(engine);this.connection=new java.lang.ref.WeakReference<>(connection);
        }
    }
    private static final NativeWeakMap<IsoPlayer,EquipmentPendingBirth> equipmentPendingBirths=new NativeWeakMap<>();
    private static final ThreadLocal<EquipmentBirth> equipmentBirthScope=new ThreadLocal<>();
    private static boolean equipmentBirthNativeCaller(Class<?> type,String method) {
        return StackWalker.getInstance(StackWalker.Option.RETAIN_CLASS_REFERENCE).walk(frames->frames
            .dropWhile(frame->frame.getDeclaringClass()==Main.class).findFirst()
            .map(frame->frame.getDeclaringClass()==type && frame.getMethodName().equals(method)).orElse(false));
    }
    private static boolean equipmentBirthTransport(zombie.core.raknet.UdpEngine engine,zombie.core.raknet.UdpConnection connection) {
        return zombie.network.GameClient.client && !zombie.network.GameServer.server
            && Thread.currentThread()==zombie.GameWindow.gameThread && zombie.network.GameClient.instance!=null
            && zombie.network.GameClient.instance.connected && engine!=null && connection!=null
            && zombie.network.GameClient.instance.udpEngine==engine && zombie.network.GameClient.connection==connection
            && equipmentRetiredConnections.get(connection)==null && engine.getActiveConnection(connection.getConnectedGUID())==connection;
    }
    public static EquipmentBirth equipmentLifetimeCoopEnter(zombie.util.AddCoopPlayer task) {
        if(!equipmentLifetimeEnabled() || task==null || !equipmentBirthNativeCaller(zombie.util.AddCoopPlayer.class,"update"))return null;
        try{synchronized(equipmentLifetimeLock){
            var actor=task.getPlayer();var engine=zombie.network.GameClient.instance==null?null:zombie.network.GameClient.instance.udpEngine;
            var connection=zombie.network.GameClient.connection;
            if(actor==null || task.isFinished() || zombie.iso.IsoWorld.instance==null
                || !zombie.iso.IsoWorld.instance.addCoopPlayers.contains(task) || !equipmentBirthTransport(engine,connection))return null;
            var scope=new EquipmentBirth(task,actor,engine,connection,equipmentBirthScope.get());equipmentBirthScope.set(scope);return scope;
        }}catch(Throwable error){equipmentLifetimeError(error);return null;}
    }
    public static void equipmentLifetimeCoopExit(EquipmentBirth scope,Throwable failure) {
        if(scope==null)return;
        try{synchronized(equipmentLifetimeLock){
            if(equipmentBirthScope.get()!=scope)throw new IllegalStateException("Native birth scope mismatch");
            if(failure!=null && scope.born!=null)scope.born.invalid=true;
        }}catch(Throwable error){equipmentLifetimeError(error);}
        finally{if(scope.previous==null)equipmentBirthScope.remove();else equipmentBirthScope.set(scope.previous);}
    }
    /** Exact original AddCoopPlayer native event; arbitrary Lua events never establish a birth. */
    public static void equipmentLifetimeCoopEvent(String event,Object index,Object supplied) {
        if(!equipmentLifetimeEnabled() || !"OnCreatePlayer".equals(event) || !(index instanceof Integer slot) || !(supplied instanceof IsoPlayer actor))return;
        try{synchronized(equipmentLifetimeLock){
            var scope=equipmentBirthScope.get();
            boolean origin=StackWalker.getInstance(StackWalker.Option.RETAIN_CLASS_REFERENCE).walk(frames->{
                var callers=frames.dropWhile(frame->frame.getDeclaringClass()!=zombie.Lua.LuaEventManager.class || !frame.getMethodName().equals("triggerEvent")).limit(2).toList();
                return callers.size()==2 && callers.get(0).getMethodType().parameterCount()==3
                    && callers.get(1).getDeclaringClass()==zombie.util.AddCoopPlayer.class && callers.get(1).getMethodName().equals("update");
            });
            if(!origin || scope==null || scope.born!=null || scope.actor!=actor || scope.task.getPlayer()!=actor
                || scope.task.getPlayerIndex()!=slot || slot!=0 || actor.playerIndex!=slot || IsoPlayer.players[slot]!=actor
                || IsoPlayer.getInstance()!=actor || !actor.isLocalPlayer() || !actor.isAlive() || actor.isDead()
                || zombie.iso.IsoWorld.instance==null || !zombie.iso.IsoWorld.instance.addCoopPlayers.contains(scope.task)
                || !equipmentBirthTransport(scope.engine,scope.connection))return;
            var previous=equipmentLife(actor,false);
            // Only a genuinely unissued preview removal is eligible for a distinct native birth.
            // Existing tokens, registered removals, deaths and repeated birth tasks stay fenced.
            if(previous==null || !previous.retired || previous.born || previous.birthPending || previous.retiredRegistered
                || previous.baseline || !previous.issued.isEmpty() || previous.poisoned || previous.depth!=0 || previous.parseDepth!=0
                || !"actor-remove".equals(previous.retirementReason))return;
            var pending=new EquipmentPendingBirth(previous,nativeTimeNext(),actor.removedFromWorldMs,scope.engine,scope.connection);
            previous.birthPending=true;equipmentPendingBirths.put(actor,pending);scope.born=pending;
            System.out.println("[CART_EQUIPMENT_BIRTH] {\"schema\":1,\"diagnosticOnly\":true,\"authorityProof\":false,\"process\":"+mpJsonString(nativeTimeProcess)
                +",\"oldActorEpoch\":"+(previous==null?0:previous.actorEpoch)+",\"newActorEpoch\":"+pending.epoch
                +",\"objectEpoch\":"+nativeTimeIdentity(actor,true)+",\"taskEpoch\":"+nativeTimeIdentity(scope.task,false)+",\"playerIndex\":"+slot
                +",\"connectionEpoch\":"+nativeTimeIdentity(scope.connection,false)+",\"removedFromWorldMsWitness\":"+pending.removedStamp
                +",\"prebirthRetired\":"+(previous!=null && previous.retired)+",\"prebirthUnissued\":"+(previous==null || previous.issued.isEmpty())
                +",\"prebirthUnbaselined\":"+(previous==null || !previous.baseline)+",\"prebirthRegistered\":"+(previous!=null && previous.retiredRegistered)+",\"prebirthReason\":"+mpJsonString(previous==null?null:previous.retirementReason)
                +",\"nativeOrigin\":\"AddCoopPlayer.update/OnCreatePlayer\",\"monoNs\":"+System.nanoTime()+"}");
        }}catch(Throwable error){equipmentLifetimeError(error);}
    }
    private static boolean equipmentPendingBirthValid(IsoPlayer actor,EquipmentPendingBirth pending) {
        return pending!=null && !pending.invalid && pending.depth==0 && pending.thread==0 && equipmentLife(actor,false)==pending.previous
            && pending.previous.retired && !pending.previous.retiredRegistered && !pending.previous.baseline && pending.previous.issued.isEmpty()
            && "actor-remove".equals(pending.previous.retirementReason) && !pending.previous.poisoned
            && actor.removedFromWorldMs==pending.removedStamp && actor.playerIndex==0 && IsoPlayer.players[0]==actor
            && IsoPlayer.getInstance()==actor && actor.isLocalPlayer() && actor.isAlive() && !actor.isDead()
            && equipmentBirthTransport(pending.engine.get(),pending.connection.get());
    }
    private static boolean equipmentLifetimeBornAfterRemoval(IsoPlayer actor) {
        var pending=equipmentPendingBirths.get(actor);
        if(equipmentPendingBirthValid(actor,pending))return true;
        var life=equipmentLife(actor,false);
        return life!=null && life.born && !life.retired && !life.poisoned && actor.removedFromWorldMs==life.birthRemovedStamp
            && life.birthEngine.get()!=null && life.birthConnection.get()!=null
            && equipmentBirthTransport(life.birthEngine.get(),life.birthConnection.get());
    }
    private static void equipmentLifetimeActivateBirth(IsoPlayer actor,zombie.core.raknet.UdpConnection connection) {
        var pending=equipmentPendingBirths.get(actor);
        var primary=actor.getPrimaryHandItem();
        if(!equipmentPendingBirthValid(actor,pending) || connection!=pending.connection.get()
            || zombie.network.GameClient.IDToPlayerMap.get(actor.getOnlineID())!=actor || actor.getOnlineID()<0
            || primary==null || primary!=actor.getSecondaryHandItem() || !equipmentLifetimeCart(primary) || primary.getWorldItem()!=null
            || equipmentLifetimeParsing.get()!=null)return;
        if(equipmentLifetimeRecords.size()>=512)throw new IllegalStateException("Equipment birth ledger limit");
        var fresh=new EquipmentLife(actor,pending.epoch);fresh.born=true;fresh.birthRemovedStamp=pending.removedStamp;
        fresh.birthEngine=pending.engine;fresh.birthConnection=pending.connection;
        equipmentLives.put(actor,fresh);equipmentLifetimeRecords.add(fresh);equipmentPendingBirths.remove(actor);
    }
    @Patch(className="zombie.util.AddCoopPlayer",methodName="update",warmUp=true)
    public static class EquipmentLifetimeCoopBirth {
        @Patch.OnEnter public static void enter(@Patch.This zombie.util.AddCoopPlayer task,@Patch.Local("equipmentBirth") EquipmentBirth scope){scope=Main.equipmentLifetimeCoopEnter(task);}
        @Patch.OnExit(onThrowable=Throwable.class,suppress=Throwable.class) public static void exit(@Patch.Local("equipmentBirth") EquipmentBirth scope,@Patch.Thrown Throwable failure){Main.equipmentLifetimeCoopExit(scope,failure);}
    }
    @Patch(className="zombie.Lua.LuaEventManager",methodName="triggerEvent",strictMatch=true,warmUp=true)
    public static class EquipmentLifetimeCoopCreateEvent {
        @Patch.OnEnter public static void enter(@Patch.Argument(0) String event,@Patch.Argument(1) Object index,@Patch.Argument(2) Object actor){Main.equipmentLifetimeCoopEvent(event,index,actor);}
    }
    /** Diagnostic snapshot only. Never admits a lifetime, creates EquipmentLife or supplies authority. */
    @LuaMethod(name="cartLeaseEligibility",global=true)
    public static String cartLeaseEligibility(IsoPlayer player) {
        if(!LEASE_LIFETIME || !LEASE_CONTROL)return null;
        try{synchronized(equipmentLifetimeLock){
            var life=player==null?null:equipmentLife(player,false);
            boolean server=zombie.network.GameServer.server && !zombie.network.GameClient.client;
            boolean client=zombie.network.GameClient.client && !zombie.network.GameServer.server;
            var engine=server?zombie.network.GameServer.udpEngine:client && zombie.network.GameClient.instance!=null?zombie.network.GameClient.instance.udpEngine:null;
            var connection=server && player!=null?zombie.network.GameServer.getConnectionFromPlayer(player):client?zombie.network.GameClient.connection:null;
            var mapped=player==null?null:zombie.network.GameClient.IDToPlayerMap.get(player.getOnlineID());
            var mappedLife=mapped==null?null:equipmentLife(mapped,false);
            var pending=player==null?null:equipmentPendingBirths.get(player);
            var primary=player==null?null:player.getPrimaryHandItem();var secondary=player==null?null:player.getSecondaryHandItem();
            int slot=player==null?-1:player.playerIndex;
            String active=engine==null || connection==null?"null":String.valueOf(engine.getActiveConnection(connection.getConnectedGUID())==connection);
            return "{\"schema\":1,\"diagnosticOnly\":true,\"authorityProof\":false,\"process\":"+mpJsonString(nativeTimeProcess)
                +",\"equipmentHealthy\":"+(!equipmentLifetimeFailed)+",\"controlHealthy\":"+(!leaseControlFailed)
                +",\"playerPresent\":"+(player!=null)+",\"actorEpoch\":"+(life==null?nativeTimeIdentity(player,true):life.actorEpoch)+",\"objectEpoch\":"+nativeTimeIdentity(player,true)
                +",\"onlineID\":"+(player==null?-1:player.getOnlineID())+",\"playerIndex\":"+slot
                +",\"localPlayer\":"+(player!=null && player.isLocalPlayer())
                +",\"localSlotExact\":"+(player!=null && slot>=0 && slot<IsoPlayer.players.length && IsoPlayer.players[slot]==player)
                +",\"currentActorExact\":"+(player!=null && IsoPlayer.getInstance()==player)
                +",\"clientMapActorEpoch\":"+(mappedLife==null?nativeTimeIdentity(mapped,true):mappedLife.actorEpoch)+",\"clientMapObjectEpoch\":"+nativeTimeIdentity(mapped,true)+",\"clientMapExact\":"+(player!=null && mapped==player)
                +",\"alive\":"+(player!=null && player.isAlive())+",\"dead\":"+(player!=null && player.isDead())
                +",\"removedFromWorldMs\":"+(player==null?0:player.removedFromWorldMs)
                +",\"sourceRole\":"+mpJsonString(server?"server":client?"client":"unknown")
                +",\"clientConnected\":"+(zombie.network.GameClient.instance!=null && zombie.network.GameClient.instance.connected)
                +",\"engineKnown\":"+(engine!=null)+",\"connectionEpoch\":"+nativeTimeIdentity(connection,false)
                +",\"connectionRetired\":"+(connection!=null && equipmentRetiredConnections.get(connection)!=null)
                +",\"exactActiveMapping\":"+active+",\"lifePresent\":"+(life!=null)
                +",\"baseline\":"+(life!=null && life.baseline)+",\"retired\":"+(life!=null && life.retired)
                +",\"poisoned\":"+(life!=null && life.poisoned)+",\"revision\":"+(life==null?0:life.revision)
                +",\"hardRevision\":"+(life==null?0:life.hardRevision)+",\"depth\":"+(life==null?0:life.depth)
                +",\"parseDepth\":"+(life==null?0:life.parseDepth)+",\"pendingBirth\":"+(pending!=null && !pending.invalid)
                +",\"pendingBirthEpoch\":"+(pending==null?0:pending.epoch)+",\"pendingBirthDepth\":"+(pending==null?0:pending.depth)+",\"born\":"+(life!=null && life.born)+",\"issuedCount\":"+(life==null?0:life.issued.size())
                +",\"primaryEpoch\":"+nativeTimeIdentity(primary,false)+",\"secondaryEpoch\":"+nativeTimeIdentity(secondary,false)
                +",\"primaryID\":"+(primary==null?"null":primary.getID())+",\"secondaryID\":"+(secondary==null?"null":secondary.getID())
                +",\"primaryType\":"+mpJsonString(primary==null?null:primary.getFullType())+",\"secondaryType\":"+mpJsonString(secondary==null?null:secondary.getFullType())
                +",\"primaryWorldAttached\":"+(primary!=null && primary.getWorldItem()!=null)
                +",\"secondaryWorldAttached\":"+(secondary!=null && secondary.getWorldItem()!=null)
                +",\"sameHands\":"+(primary!=null && primary==secondary)+"}";
        }}catch(Throwable error){return null;}
    }
    @LuaMethod(name="cartLeaseLifetime",global=true)
    public static String cartLeaseLifetime(IsoPlayer player) {
        if(!equipmentLifetimeEnabled())return null;
        try{synchronized(equipmentLifetimeLock){var connection=equipmentLifetimeConnection(player);return connection==null?null:equipmentLifetimeRead(player,connection);}}
        catch(Throwable error){equipmentLifetimeError(error);return null;}
    }
