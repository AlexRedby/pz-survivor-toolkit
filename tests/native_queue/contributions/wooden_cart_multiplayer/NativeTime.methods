    public static void nativeTimeCopied(zombie.network.fields.character.Prediction destination,zombie.network.fields.character.Prediction source,Throwable failure) {
        if(!TIMELINE || failure!=null)return;
        try {
            var scope=nativeTimeCopy.get();if(scope==null || destination!=scope.ai().prediction || source!=scope.packet().prediction)return;
            if(nativeTimeReceipts.get(scope.packet())!=scope.receipt())throw new IllegalStateException("Native cached packet parse changed within copy scope");
            nativeTimeAccepted.put(scope.owner(),new NativeAccepted(scope.receipt(),new java.lang.ref.WeakReference<>(destination)));timelineEvent("player-accepted",scope.owner(),nativeTimeReceiptFields(scope.owner(),scope.receipt()));
        }catch(Throwable error){timelineError(error);}
