            if(duplicate.remaining()>=3){short id=duplicate.getShort();int index=duplicate.get();
                owner=zombie.network.GameServer.server && index>=0?connection.getPlayerAt(index):zombie.network.GameClient.client?zombie.network.GameClient.IDToPlayerMap.get(id):zombie.network.GameServer.IDToPlayerMap.get(id);}
            if(timelineOwner(owner))timelineEvent("player-ingress",owner,nativeTimeFields(owner,receipt.connection(),receipt.peer(),receipt.type(),receipt.typeName(),body,null,0,0,0,receipt.generation(),receipt.mono()));
        }catch(Throwable error){timelineError(error);}
