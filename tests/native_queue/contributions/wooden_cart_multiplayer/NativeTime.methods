                send.motionAtWrite=owner.isLocalPlayer()?owner.getVariableString("ToolkitCartPose"):null;
                send.actionAtWrite=owner.isLocalPlayer()?owner.getVariableString("ToolkitCartActionPose"):null;}
            String fields=nativeTimeFields(owner,send==null?0:send.connection,send==null?nativeTimePeer(endpoint,true):send.peer,send==null?-1:send.type,send==null?"unavailable":send.typeName,body,source,send==null?0:send.generation,parent==null?0:parent.generation(),0,0,0)
                +",\"serializedBytes\":"+body.bytes();
