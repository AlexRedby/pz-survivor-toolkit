    // This labels the accepted native input; stateful animation is not exclusively derived from it.
    public static String timelineNativeSnapshot(IsoPlayer owner) {
        if(!TIMELINE)return "";
        try {
            var accepted=owner==null || owner.isLocalPlayer()?null:nativeTimeAccepted.get(owner);
            var receipt=accepted==null || accepted.prediction().get()!=owner.getNetworkCharacterAI().prediction?null:accepted.receipt();
            if(receipt!=null && !zombie.network.GameServer.server && receipt.connection()!=nativeTimeIdentity(zombie.network.GameClient.connection,false))receipt=null;
            return ",\"nativeInputVersion\":1,\"nativeProcessEpoch\":"+mpJsonString(nativeTimeProcess)+",\"nativeActorEpoch\":"+nativeTimeIdentity(owner,true)
                +",\"nativeReceiveGeneration\":"+(receipt==null?0:receipt.generation())+",\"nativeConnectionEpoch\":"+(receipt==null?0:receipt.connection())
                +",\"nativeIngressGeneration\":"+(receipt==null?0:receipt.ingress())+",\"nativePacketSha256\":"+mpJsonString(receipt==null?"":receipt.body().sha());
        }catch(Throwable error){timelineError(error);return "";}
    }

