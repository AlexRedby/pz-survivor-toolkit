    public static final class NativeWeakMap<K,V> {
        private final java.util.ArrayList<java.lang.ref.WeakReference<K>> keys=new java.util.ArrayList<>();
        private final java.util.ArrayList<V> values=new java.util.ArrayList<>();
        public synchronized V get(K key) {
            for(int i=keys.size()-1;i>=0;i--) {K known=keys.get(i).get();if(known==null){keys.remove(i);values.remove(i);}else if(known==key)return values.get(i);}
            return null;
        }
        public synchronized void put(K key,V value) {
            if(key==null)throw new IllegalArgumentException("Null native identity");
            for(int i=keys.size()-1;i>=0;i--) {K known=keys.get(i).get();if(known==null){keys.remove(i);values.remove(i);}else if(known==key){values.set(i,value);return;}}
            if(keys.size()>=512)throw new IllegalStateException("Native identity map limit");
            keys.add(new java.lang.ref.WeakReference<>(key));values.add(value);
        }
        public synchronized void remove(K key) {
            for(int i=keys.size()-1;i>=0;i--)if(keys.get(i).get()==null || keys.get(i).get()==key){keys.remove(i);values.remove(i);}
        }
    }
