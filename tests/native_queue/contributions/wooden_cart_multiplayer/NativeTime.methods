        }catch(Throwable error){timelineError(error);return null;}
    }
    public static void nativeTimeSourceExit(zombie.network.packets.character.PlayerPacket packet,IsoPlayer owner,NativeSource source,Throwable failure) {
        if(source==null)return;
        try {
            if(failure!=null){nativeTimeSources.remove(packet);return;}
            var done=new NativeSource(source.generation(),source.actor(),source.begin(),System.nanoTime(),source.motionBegin(),owner.getVariableString("ToolkitCartPose"),source.actionBegin(),owner.getVariableString("ToolkitCartActionPose"));
            nativeTimeSources.put(packet,done);
            timelineEvent("player-source-set",owner,nativeTimeFields(owner,0,"unavailable",-1,"unavailable",null,done,0,0,0,0,0)
                +",\"sourceMotionRawAtSetBegin\":"+mpJsonString(done.motionBegin())+",\"sourceMotionRawAtSetEnd\":"+mpJsonString(done.motionEnd())
                +",\"sourceActionRawAtSetBegin\":"+mpJsonString(done.actionBegin())+",\"sourceActionRawAtSetEnd\":"+mpJsonString(done.actionEnd()));
        }catch(Throwable error){timelineError(error);}
    }
    public static void nativeTimeStart(zombie.core.raknet.UdpConnection connection,zombie.core.network.ByteBufferWriter writer,Throwable failure) {
