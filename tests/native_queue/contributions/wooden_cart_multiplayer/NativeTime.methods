    public record NativeBody(String hex,String sha,int bytes,String order) {}
    public static NativeBody nativeTimeBody(java.nio.ByteBuffer buffer,int begin,int end) {
        if(buffer==null || begin<0 || end<begin || end>buffer.limit() || end-begin>256)throw new IllegalArgumentException("Native body span exceeds bounds");
        var copy=buffer.duplicate();copy.position(begin);copy.limit(end);byte[] bytes=new byte[end-begin];copy.get(bytes);
        try {
            var hex=java.util.HexFormat.of();
            return new NativeBody(hex.formatHex(bytes),hex.formatHex(java.security.MessageDigest.getInstance("SHA-256").digest(bytes)),bytes.length,buffer.order().toString());
        } catch(java.security.NoSuchAlgorithmException impossible){throw new IllegalStateException(impossible);}
    }
