    private static String nativeTimeFields(IsoPlayer owner,long connection,String peer,int type,String typeName,NativeBody body,NativeSource source,long send,long serverReceive,long receive,long ingress,long ingressMono) {
        return ",\"nativePacketVersion\":1,\"nativeProcessEpoch\":"+mpJsonString(nativeTimeProcess)
            +",\"actorEpoch\":"+nativeTimeIdentity(owner,true)+",\"connectionEpoch\":"+connection+",\"peerRole\":"+mpJsonString(peer)
            +",\"packetType\":"+type+",\"packetTypeName\":"+mpJsonString(typeName)
            +",\"packetBodyHex\":"+mpJsonString(body==null?"":body.hex())+",\"packetSha256\":"+mpJsonString(body==null?"":body.sha())
            +",\"packetBytes\":"+(body==null?0:body.bytes())+",\"packetByteOrder\":"+mpJsonString(body==null?"unavailable":body.order())
            +",\"sourceSetGeneration\":"+(source==null?0:source.generation())+",\"sourceSampleBeginNs\":"+(source==null?0:source.begin())
            +",\"sourceSampleEndNs\":"+(source==null?0:source.end())+",\"sendGeneration\":"+send+",\"serverReceiveGeneration\":"+serverReceive
            +",\"receiveGeneration\":"+receive+",\"ingressGeneration\":"+ingress+",\"ingressMonoNs\":"+ingressMono;
    }
    private static String nativeTimeReceiptFields(IsoPlayer owner,NativeReceipt receipt) {
        return nativeTimeFields(owner,receipt.connection(),receipt.peer(),receipt.type(),receipt.typeName(),receipt.body(),null,0,
            zombie.network.GameServer.server?receipt.generation():0,receipt.generation(),receipt.ingress(),receipt.ingressMono());
    }
    public static NativeSource nativeTimeSourceEnter(zombie.network.packets.character.PlayerPacket packet,IsoPlayer owner) {
        if(!TIMELINE || !timelineOwner(owner) || !owner.isLocalPlayer() || zombie.network.GameServer.server)return null;
        try {
            var source=new NativeSource(nativeTimeNext(),nativeTimeIdentity(owner,true),System.nanoTime(),0,
                owner.getVariableString("ToolkitCartPose"),null,owner.getVariableString("ToolkitCartActionPose"),null);
