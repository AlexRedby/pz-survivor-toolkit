<?xml version="1.0" encoding="utf-8"?>
<animNode>
    <m_Name>default</m_Name>
    <m_AnimName>Bob_ToolkitVehicleExit</m_AnimName>
    <m_Looped>false</m_Looped>
    <!-- The near foot steps out before the trailing foot lifts; the body rises outside.
         VehicleTransitionRender synchronizes only the rendered seat transfer. -->
    <m_BlendTime>0.00</m_BlendTime>
    <m_SpeedScale>1.60</m_SpeedScale>
    <m_Events>
        <m_EventName>SetVariable</m_EventName>
        <m_Time>End</m_Time>
        <m_ParameterValue>ExitAnimationFinished=true</m_ParameterValue>
    </m_Events>
</animNode>
